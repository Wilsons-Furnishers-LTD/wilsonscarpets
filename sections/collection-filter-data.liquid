{%- comment -%}
  Data endpoint for the asynchronous tag filters (src/scripts/tag-filters.js).
  Not placed in any template: it is requested through the Section Rendering API,
  e.g. /collections/carpets/filter-colour_grey?section_id=collection-filter-data&page=2&sort_by=price-ascending
  Outputs every product card on the page together with its tag handles so the
  script can filter (OR within a tag group, AND across groups) client-side.
{%- endcomment -%}
{%- paginate collection.products by 100 -%}
  <div data-filter-data data-pages="{{ paginate.pages }}" data-current-page="{{ paginate.current_page }}">
    {%- for product in collection.products -%}
      <div data-filter-product data-tags="{% for tag in product.tags %}{{ tag | handle }}{% unless forloop.last %}|{% endunless %}{% endfor %}">
        {%- render 'product-grid-item', product: product -%}
      </div>
    {%- endfor -%}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection filter data",
  "settings": []
}
{% endschema %}
