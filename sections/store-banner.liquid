{% render 'store-banner-content', store: metaobject, section_id: section.id, map_zoom: section.settings.map_zoom %}

{% schema %}
    {
        "name": "Store Banner",
        "class": "index-section",
        "settings": [
            {
                "type": "range",
                "id": "map_zoom",
                "label": "Map zoom",
                "info": "For stores whose Store Banner Show Map field is on.",
                "min": 10,
                "max": 18,
                "step": 1,
                "default": 15
            }
        ],
        "presets": [{
            "name": "Store Banner",
            "category": "Image"
        }]
    }
{% endschema %}
