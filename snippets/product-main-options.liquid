                                                <select>
                                                    {% for value_size in value_sizes %}
                                                        <option value="{{ value_size }}">{{ value_size }}</option>
                                                    {% endfor %}
                                                    {% comment %} {% for value_size in value_sizes %}
                                                        <option value="{{ value_size }}">{{ value_size }}</option>
                                                    {% endfor %} {% endcomment %}

                                                    {% comment %} Waqar
                                                    {% for variant in product.variants %}
                                                        <option value="{{ variant.title }}" {% if variant.metafields.juno.is_in_stock == "0" %} disabled="disabled" {% endif %}>{{ variant.title }}</option>
                                                    {% endfor %}
                                                    {% endcomment %}
                                                    {% comment %} {% for variant in product.variants %}
                                                        <option value="{{ variant.title }}" {% if variant.metafields.juno.is_in_stock == "0" %} disabled="disabled" {% endif %}>{{ variant.title }}</option>
                                                    {% endfor %} {% endcomment %}
                                                </select>


                                            </div>
                                        </div>
                                        <div id="widthFeetInches" class="measurementSelect">
