<div data-section-id="{{ section.id }}" data-section-type="banner" class="banner-grid two">
    {% if section.blocks.size > 0 %}
    <div class="wrapper">
        <div class="row">
            {% for block in section.blocks %}
                <div class="col-wide-6 col-small-6 col-img {{ block.settings.text_color | escape }}">
                    {% if block.settings.link != blank %}
                        <a class="image" href="{{ block.settings.link }}">
                    {% endif %}	
                    {% if block.settings.image %}
                        <picture>
                            <source media="(min-width: 1024px)" srcset="{{ block.settings.image | img_url: 'master' }}">
                            {% if block.settings.mobile_image != blank %}
                                <source srcset="{{ block.settings.mobile_image | img_url: 'master' }}">
                            {% endif %}
                            <img loading="lazy" width="647" height="367" importance="low" src="{{ block.settings.image | img_url: 'master' }}" alt="" />
                        </picture>
                    {% else %}
                    <span class="placeholder-background">
                        {% capture current %}{% cycle 1, 2 %}{% endcapture %}
                        {{ 'lifestyle-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                    </span>
                    {% endif %}
                    {% if block.settings.link != blank %}
                        </a>
                    {% endif %}	
                    {% if block.settings.title != blank or block.settings.subheading != blank %}
                    <div class="text-wrap overlay">
                        <div class="wrapper">
                            <div class="text-content">
                                <div class="box">
                                    <div class="title-wrapper">
                                        {% unless block.settings.title == blank %}
                                        <h2 class="title">{{ block.settings.title }}</h2>
                                        {% endunless %}
                                        {% unless block.settings.subheading == blank %}
                                        <p class="subtitle">{{ block.settings.subheading }}</p>
                                        {% endunless %}
                                    </div>
                                    {% if block.settings.link != blank %}
                                    <a class="button small" href="{{ block.settings.link }}">{{ block.settings.button_text }}</a>
                                    {% endif %}	
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endif %}	
                </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}
</div>

{% schema %}
    {
        "name": "Banner Grid - Two",
        "class": "index-section",
        "max_blocks": 4,
        "blocks": [
            {
                "type": "image",
                "name": "Banner",
                "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Image"
                },
                {
                    "type": "image_picker",
                    "id": "mobile_image",
                    "label": "Mobile Image"
                },
                {
                    "type": "select",
                    "id": "text_color",
                    "label": "Text color",
                    "options": [
                        { "value": "text-light", "label": "Light" },
                        { "value": "text-dark", "label": "Dark" }
                    ],
                    "default": "text-dark"
                },
                {
                    "type": "text",
                    "id": "title",
                    "label": "Heading",
                    "default": "Image slide"
                },
                {
                    "type": "text",
                    "id": "subheading",
                    "label": "Subheading",
                    "default": "Lorem ipsum dolor sit amet, consectetur"
                },
                {
                    "type": "url",
                    "id": "link",
                    "label": "Link"
                },
                {
                    "type": "text",
                    "id": "button_text",
                    "label": "Button Text",
                    "default": "Shop Now"
                }
                ]
            }
        ],
        "presets": [{
            "name": "Banner Grid - Two",
            "category": "Image",
            "blocks": [
                {
                    "type": "image"
                },
                {
                    "type": "image"
                }
            ]
        }]
    }
{% endschema %}
