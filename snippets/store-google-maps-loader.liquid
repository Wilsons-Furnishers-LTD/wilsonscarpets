{%- comment -%}
    Loads the Google Maps JavaScript API (with the Places library) once per page and runs callbacks when it's ready.
    Used by sections/store-map.liquid and sections/store-google-reviews.liquid.
    Same API key as the store locator (sections/store-locator.liquid).

    Usage: {% render 'store-google-maps-loader' %} then window.storeLoadGoogleMaps(function () { ... })
{%- endcomment -%}
<script>
    window.storeLoadGoogleMaps = window.storeLoadGoogleMaps || (function () {
        var callbacks = [];
        var loading = false;

        window.storeGoogleMapsReady = function () {
            var queued = callbacks;
            callbacks = [];
            queued.forEach(function (cb) { cb(); });
        };

        return function (cb) {
            if (window.google && google.maps && google.maps.Map) return cb();
            callbacks.push(cb);
            if (loading) return;
            loading = true;
            var script = document.createElement('script');
            script.src = 'https://maps.googleapis.com/maps/api/js?key=AIzaSyDW3vqDk5Ow2bKE3pgC4i9GYi4IxZBcIkQ&libraries=places&language=en&loading=async&callback=storeGoogleMapsReady';
            script.async = true;
            document.head.appendChild(script);
        };
    })();
</script>
