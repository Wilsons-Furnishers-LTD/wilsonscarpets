      {% for cat_item in cat_array %}
        {% assign catLower = cat_item | downcase %}
        {% assign allTagsToOutput = "filter-colour|backing|style|filterlength|width|shade|thick_filter|manufacturer" %}
          {% if allTagsToOutput contains catLower %}

          {% assign thisTile = cat_item | capitalize %}
          {% assign thisTile_class = cat_item | downcase %}

          {% if thisTile == "Filterlength" %}
            {% assign thisTile = "Remnant Length" %}
            {% assign thisTile_class = "Length" %}
          {% endif %}

          {% if thisTile == "Filter-colour" %}
            {% assign thisTile = "Colour" %}
            {% assign thisTile_class = "colour" %}
          {% endif %}

          {% if thisTile == "Thick_filter" %}
            {% assign thisTile = "Thickness" %}
            {% assign thisTile_class = "Thickness" %}
          {% endif %}

          {% assign markupToOutput = markupToOutput | append: '<div id="' | append: thisTile_class | append: '" class="filter-column">' %}
        {% assign markupToOutput = markupToOutput | append: '<h3>' | append: thisTile | append: '</h3><ul class="advanced-filters">' %}
          {% comment %}
            Loop through collection tags
          {% endcomment %}
          {% assign this_loop_counter = 0 %}
          {% for tag in collection.tags %}

            {% assign thisFilter = cat_item | append: '_' %}
            {% if tag contains thisFilter %}

              {% comment %}
                Strip out tag category prefix and add/remove link for tag filtering
              {% endcomment %}
              {% assign tagText = tag | remove_first: thisFilter %}
              {% assign thisTitleTag = "Narrow selection to products matching tag " | append: tag %}
              {% assign currentTitleTag = "Filter by tag " | append: tagText %}
              {% if tagText != blank %}
                {% assign thisTagHandle = tag | handle %}
                {% assign thisSwatch = '' %}
                {% if thisFilter == 'Filter-Colour_' %}
                  {% comment %}<!-- create swatch: /-->{% endcomment %}
                  {% assign swatchSrc = tagText | downcase | append: "-" | append: thisCollectionsProductType | append: ".jpg" | file_img_url: '22x22', crop: 'center' %}
                  {% assign thisSwatch = '<img src="' | append: swatchSrc | append: '">' %}
                {% endif %}

                {% if current_tags contains tag %}
                  {% assign tagTextToAdd = tagText | link_to_remove_tag: tag | replace: thisTitleTag, currentTitleTag %}
                  {% if thisSwatch != '' %}
                    {% assign replacementText = '"> ' | append: thisSwatch %}
                    {% assign tagTextToAdd = tagTextToAdd | replace: '">', replacementText %}
                  {% endif %}
                  {% assign markupToOutput = markupToOutput | append: '<li class="advanced-filter active-filter ' | append: thisFilter | append: '" data-group="' | append: cat_item | append: '" data-handle="' | append: thisTagHandle | append: '">' | append: tagTextToAdd | append: '</li>' %}
                  {% assign hasActive = '' %}
                  {% assign markupActiveToOutput = markupActiveToOutput | append: '<li class="advanced-filter active-filter ' | append: thisFilter | append: '" data-group="' | append: cat_item | append: '" data-handle="' | append: thisTagHandle | append: '">' | append: tagTextToAdd | append: '</li>' %}
                {% else %}
                  {% assign tagTextToAdd = tagText | link_to_add_tag: tag | replace: thisTitleTag, currentTitleTag %}
                  {% if thisSwatch != '' %}
                    {% assign replacementText = '"> ' | append: thisSwatch %}
                    {% assign tagTextToAdd = tagTextToAdd | replace: '">', replacementText %}
                  {% endif %}
                  {% assign markupToOutput = markupToOutput | append: '<li class="advanced-filter ' | append: thisFilter | append: '" data-group="' | append: cat_item | append: '" data-handle="' | append: thisTagHandle | append: '">' | append: tagTextToAdd | append: '</li>' %}
                {% endif %}
                {% assign this_loop_counter = this_loop_counter | plus: 1 %}
                {% assign loopCount = this_loop_counter | modulo: 8 %}
              {% endif %}
            {% endif %}
          {% endfor %}
          {% assign markupToOutput = markupToOutput | append: '</ul>' %}
          {% assign markupToOutput = markupToOutput | append: '</div>' %}
        {% endif %}
      {% endfor %}

      {% if hasActive %}
        {% assign clearAllToAdd = 'Clear All' | link_to: collection.url %}
        {% assign markupActiveToOutput = markupActiveToOutput | prepend: '<ul id="filters-current">' %}
        {% assign markupActiveToOutput = markupActiveToOutput | append: '<li class="clear-all"' | append: '">' | append: clearAllToAdd | append: '</li>' %}
        {% assign markupActiveToOutput = markupActiveToOutput | append: '</ul>' %}
      {% endif %}

      {{ markupToOutput }}
    </div>
