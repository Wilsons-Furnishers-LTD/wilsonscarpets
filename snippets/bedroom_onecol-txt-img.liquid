{% case block.settings.add_border_top %}
	{% when 'add_border_top_yes' %}
		{%- assign border_top = 'border-top' -%}
	{% when 'add_border_top_no' %}
		{%- assign border_top = '' -%}
{% endcase %} 

{% case block.settings.add_border_bottom %}
	{% when 'add_border_bottom_yes' %}
		{%- assign border_bottom = 'border-bottom' -%}
	{% when 'add_border_bottom_no' %}
		{%- assign border_bottom = '' -%}
{% endcase %}  

<div data-section-id="{{ section.id }}" data-section-type="onecol-txt-section" class="onecolumn-txt-section txt-section {% if block.settings.class != blank %}{{block.settings.class}}{% endif %} {% if block.settings.background_color != blank %}bg{% endif %}" {% if block.settings.background_color != blank %}style="background-color: {{block.settings.background_color}}" {% endif %}>
	<div class="wrapper">
		<div class="container {{ border_bottom }} {{ border_top }}">
			{% case block.settings.text_align %}
				{% when 'text-left' %}
					{%- assign text_direction = 'text-left' -%}
				{% when 'text-center' %}
					{%- assign text_direction = 'text-center' -%}
				{% when 'text-right' %}
					{%- assign text_direction = 'text-right' -%}
			{% endcase %}  
			<div class="row {{ text_direction }}">
				{% if block.settings.image_position == 'image_above_text' %}
					{% if block.settings.image %}
						<picture>
							<source media="(min-width: 1024px)" srcset="{{ block.settings.image | img_url: '1920x' }}">
							<source media="(min-width: 768px)" srcset="{{ block.settings.image | img_url: '1024x680', crop: 'center' }}">
							{% if block.settings.mobile_image != blank %}
								<source srcset="{{ block.settings.mobile_image | img_url: '1920x' }}">
							{% else %}
								<source srcset="{{ block.settings.image | img_url: '640x600', crop: 'center' }}">    
							{% endif %}
							<img src="{{ block.settings.image | img_url: '1920x' }}" alt="" />
						</picture>
					{% else %}
					<span class="placeholder-background">
						{% capture current %}{% cycle 1, 2 %}{% endcapture %}
						{{ 'lifestyle-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
					</span>
					{% endif %}
				{% endif %}
				<div class="text-content">
				{% if block.settings.title != blank %}
					{% if block.settings.is_title_h1 == 'is_title_h1_yes' %}
						<h1>
							{{ block.settings.title }}
						</h1>
					{% else %}
						<h2>
							{{ block.settings.title }}
						</h2>
					{% endif %}
				{% endif %}
				{% if block.settings.content != blank %}
					<div class="subtitle">{{ block.settings.content }}</div>
				{% endif %}
				</div>
				{% if block.settings.image_position == 'image_under_text' %}
					{% if block.settings.image %}
						<picture>
							<source media="(min-width: 1024px)" srcset="{{ block.settings.image | img_url: '1920x' }}">
							<source media="(min-width: 768px)" srcset="{{ block.settings.image | img_url: '1024x680', crop: 'center' }}">
							{% if block.settings.mobile_image != blank %}
								<source srcset="{{ block.settings.mobile_image | img_url: '1920x' }}">
							{% else %}
								<source srcset="{{ block.settings.image | img_url: '640x600', crop: 'center' }}">    
							{% endif %}
							<img src="{{ block.settings.image | img_url: '1920x' }}" alt="" />
						</picture>
					{% else %}
					<span class="placeholder-background">
						{% capture current %}{% cycle 1, 2 %}{% endcapture %}
						{{ 'lifestyle-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
					</span>
					{% endif %}
				{% endif %}
			</div>
		</div>
	</div>
</div>