{{ 'store-gallery.css' | asset_url | stylesheet_tag }}
{%- comment -%}
    Store gallery: thumbnails on the left, main image in the middle, text content on the right.
    One block per image. Uses Owl Carousel v2, which layout/theme.liquid already loads (deferred) along with jQuery.
    Styles: src/styles/store-gallery/_index.scss -> assets/store-gallery.css (npm run build)

    Text comes from the current store_page metaobject's store_content field (rich text or multi-line text),
    so it only shows on store pages. The section has no settings of its own.
{%- endcomment -%}
{{metaobject | json}}
{%- assign store_content = metaobject.store_content -%}
{%- capture content_html -%}
    {%- if store_content.value != blank -%}
        {%- if store_content.type == 'rich_text_field' -%}
            {{- store_content | metafield_tag -}}
        {%- else -%}
            {%- comment -%} Blank lines start a new paragraph; single line breaks are kept {%- endcomment -%}
            {%- assign paragraphs = store_content.value | escape | newline_to_br | strip_newlines | split: '<br /><br />' -%}
            {%- for paragraph in paragraphs -%}
                {%- assign paragraph_text = paragraph | remove: '<br />' | strip -%}
                {%- if paragraph_text != blank -%}<p>{{ paragraph | strip }}</p>{%- endif -%}
            {%- endfor -%}
        {%- endif -%}
    {%- endif -%}
{%- endcapture -%}
{%- assign content_html = content_html | strip -%}
<div class="store-gallery" data-section-id="{{ section.id }}" data-section-type="store-gallery">
    <div class="wrapper">
        <div class="store-gallery__layout{% if content_html == blank %} store-gallery__layout--no-content{% endif %}">
            <div class="store-gallery__gallery">
                {% if section.blocks.size > 1 %}
                    <ul class="store-gallery__thumbs" aria-label="Choose image">
                        {% for block in section.blocks %}
                            <li>
                                <button type="button"
                                    class="store-gallery__thumb{% if forloop.first %} is-active{% endif %}"
                                    data-index="{{ forloop.index0 }}"
                                    aria-label="Show image {{ forloop.index }} of {{ forloop.length }}"
                                    {% if forloop.first %}aria-current="true"{% endif %}>
                                    {% if block.settings.image != blank %}
                                        {{ block.settings.image | image_url: width: 160, height: 160, crop: 'center' | image_tag: alt: '', loading: 'lazy' }}
                                    {% else %}
                                        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                                    {% endif %}
                                </button>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                {% if section.blocks.size > 0 %}
                    <div class="store-gallery__main">
                        <div class="owl-carousel" id="StoreGallery-{{ section.id }}">
                            {% for block in section.blocks %}
                                <div class="store-gallery__slide" {{ block.shopify_attributes }}>
                                    {% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{% endif %}
                                    {% if block.settings.image != blank %}
                                        {{ block.settings.image | image_url: width: 1200 | image_tag:
                                            widths: '540, 800, 1000, 1200',
                                            sizes: '(min-width: 990px) 45vw, 100vw',
                                            alt: block.settings.image.alt,
                                            loading: 'lazy'
                                        }}
                                    {% else %}
                                        {%- capture current -%}{% cycle 1, 2 %}{%- endcapture -%}
                                        {{ 'lifestyle-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                                    {% endif %}
                                    {% if block.settings.link != blank %}</a>{% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            </div>

            {% if content_html != blank %}
                <div class="store-gallery__content">
                    <div class="store-gallery__text">{{ content_html }}</div>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<script>
    (function () {
        var sectionId = '{{ section.id }}';

        function init() {
            if (!window.jQuery || !jQuery.fn.owlCarousel) return;
            var $main = jQuery('#StoreGallery-' + sectionId);
            if (!$main.length) return;
            var $thumbs = $main.closest('.store-gallery').find('.store-gallery__thumb');

            $main.trigger('destroy.owl.carousel');
            $thumbs.off('.storeGallery');

            function setActive(index) {
                $thumbs.removeClass('is-active').removeAttr('aria-current');
                $thumbs.eq(index).addClass('is-active').attr('aria-current', 'true');
            }

            $main.on('changed.owl.carousel', function (e) {
                if (e.item && e.item.index !== null) setActive(e.item.index);
            });

            $main.owlCarousel({
                items: 1,
                loop: false,
                rewind: true,
                nav: false,
                dots: $thumbs.length > 0,
                smartSpeed: 500
            });

            $thumbs.on('click.storeGallery', function () {
                $main.trigger('to.owl.carousel', [parseInt(jQuery(this).data('index'), 10), 500]);
            });
        }

        // owl.carousel.js is loaded with defer, so wait for it
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }

        // Re-initialise when the section is edited in the theme editor, and jump to a block when it's selected
        document.addEventListener('shopify:section:load', function (e) {
            if (e.detail.sectionId === sectionId) init();
        });
        document.addEventListener('shopify:block:select', function (e) {
            if (e.detail.sectionId !== sectionId || !window.jQuery) return;
            var index = jQuery(e.target).closest('.owl-item').index();
            if (index > -1) jQuery('#StoreGallery-' + sectionId).trigger('to.owl.carousel', [index, 300]);
        });
    })();
</script>

{% schema %}
    {
        "name": "Store Gallery",
        "class": "index-section",
        "settings": [],
        "blocks": [
            {
                "type": "slide",
                "name": "Image",
                "settings": [
                    {
                        "type": "image_picker",
                        "id": "image",
                        "label": "Image"
                    },
                    {
                        "type": "url",
                        "id": "link",
                        "label": "Link"
                    }
                ]
            }
        ],
        "presets": [{
            "name": "Store Gallery",
            "category": "Image",
            "blocks": [
                { "type": "slide" },
                { "type": "slide" },
                { "type": "slide" },
                { "type": "slide" }
            ]
        }]
    }
{% endschema %}
