{% assign specifications = product.metafields.custom.specifications.value %}

<div class="product-page">
    <div class="product-description">
        <div class="row">
            <div class="description">
                <h2 class="title">Description</h2>
                <div class="content" itemprop="description">
                    {{ product.description }}
                </div>
            </div>

                        
            {% if section.blocks.size > 0 %}
                <div class="specifications">
                    {% if section.settings.title != blank %} 
                        <h2 class="title">{{ section.settings.title }}</h2>
                    {% endif %} 
                    
                    {% if specifications %}
                        <ul>
                            {% for specification in specifications %}
                                <li><strong>{{ specification | replace: ':', '</strong><span>' }}</span></li>
                            {% endfor %}
                        </ul>
                    {% else %} 
                        <div class="content">
                            <ul>
                                {% for block in section.blocks %}
                                    {% assign spec_tag = block.settings.tag | append: '_' %}
                                    {% for tag in product.tags %}
                                        {% if tag contains spec_tag %} 
                                            <li><strong>{{ block.settings.tag }}</strong> <span>{{ tag | replace: spec_tag, '' }}</span></li>
                                        {% endif %} 
                                    {% endfor %}
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %} 
                </div>
            {% endif %}

            <div class="delivery">
                <h2 class="title">Delivery</h2>
                {% assign delivery_type = product.type | prepend: 'delivery-' | append: '-block' | handleize %}
                <div class="content">
                    {% if pages[delivery_type] %}
                        {{ pages[delivery_type].content }}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

{% schema %}
{
	"name": "Specifications",
    "settings": [
        {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Specifications"
        }
    ],
    "blocks": [
        {
            "type": "tags",
            "name": "Tag Specifications",
            "settings": [
                {
                    "type": "text",
                    "id": "tag",
                    "label": "Tag"
                }
            ]
        }
    ]
}
{% endschema %}