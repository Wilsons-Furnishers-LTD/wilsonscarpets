<style>
    .standardProduct .content.colour-dropdown {
        display: none;
    }
    .product-details .option-colour {
        display: flex;
        flex-direction: column;
    }
    .product-page #product-variants.standardProduct.option-single {
        border-top: 0;
    }
    .product-details .option-colour #product-variants {
        order: -1
    }

    .numberOfOptions2.standardProduct .selector-wrapper:first-child {
        display: block;
    }
</style>
{% assign add_to_cart = 'Add to Basket' %}
{% assign adding_to_cart = 'Adding' %}
{% assign added_to_cart = 'Added' %}
{% assign go_to_checkout = 'Go to Checkout' %}
{% assign sold_out = 'Sold Out' %}
{% assign unavailable = 'Unavailable' %}

{% assign minimumLength = '' %}

{% for tag in product.tags %}

    {% if tag contains 'parent_' %}
        {% assign parentHandle = tag | replace: 'parent_', '' %}
        <script>
            window.location = "/products/{{ parentHandle }}";
        </script>
    {% endif %}
    {% if tag contains 'RRP_' %}
        {% assign RRPPrice = tag | replace: 'RRP_', '' | plus: 0 %}
    {% endif %}
    {% if tag contains 'Pack Size (M²)_' %}
        {% assign packSizePerSQM = tag | replace: 'Pack Size (M²)_', '' | split: 'm' | first | plus: 0 %}
    {% endif %}
    {% if tag contains 'Before Label_' %}
        {% assign beforeText = tag | replace: 'Before Label_', '' | prepend: "<small>" | append: "</small> " %}
    {% endif %}
    {% if tag contains 'After Label_' %}
        {% assign afterText = tag | replace: 'After Label_', '' | prepend: " " %}
    {% endif %}
    {% if tag contains 'promo_' %}
        {% assign productPromo = tag | replace: 'promo_' %}
    {% endif %}
    {% if tag contains 'minLength_' %}
        {% assign minimumLength = tag | replace: 'minLength_' %}
    {% endif %}

    {% if tag contains 'default-length_' %}
        {% assign defaultLength = tag | replace: 'default-length_', '' %}
    {% endif %}

    {% if tag contains 'identifier_exists_' %}
        {% assign GTINexist = tag | replace: 'identifier_exists_', '' %}
    {% endif %}

    {% if tag contains 'GTIN_' %}
        {% assign GTINvalue = tag | replace: 'GTIN_', '' %}
    {% endif %}


    {% if tag contains 'ShoppingID_' %}
        {% assign ShoppingID = tag | replace: 'ShoppingID_', '' %}
    {% endif %}
{% endfor %}

{% for product_option in product.options_with_values %}
    {% assign product_option_name = product_option.name | downcase %}
    {% assign position = product_option.position | minus: 1 %}
    {% if product_option_name == 'color' or product_option_name == 'colour' %}
        {% assign value_colors = '' %}
        {% assign position_option_colors = position %}
        {% for variant in product.variants %}
            {% assign value = variant.title | split: ' / ' %}
            {% assign value = value[position] | lstrip %}
            {% assign value_colors = value_colors | append: value %}
            {% if forloop.last == false %}
                {% assign value_colors = value_colors | append: ' / ' %}
            {% endif %}
        {% endfor %}
        {% assign value_colors = value_colors | split: ' / ' | uniq %}
    {% endif %}
    {% if product_option_name == 'width' or product_option_name == 'rug size' %}
        {% assign value_sizes = '' %}
        {% assign length_value_sizes = '' %}
        {% assign position_option_size = position %}
        {% for variant in product.variants %}
            {% assign value = variant.title | split: ' / ' %}
            {% assign value = value[position] | lstrip %}
            {% assign value_sizes = value_sizes | append: value %}
            {% if variant.metafields.juno.is_in_stock == "1" %}
                {% assign length_value_sizes = length_value_sizes | append: value %}
            {% endif %}
            {% if forloop.last == false %}
                {% if variant.metafields.juno.is_in_stock == "1" %}
                    {% assign length_value_sizes = length_value_sizes | append: ' / ' %}
                {% endif %}
                {% assign value_sizes = value_sizes | append: ' / ' %}
            {% endif %}
        {% endfor %}
        {% assign value_sizes = value_sizes | split: ' / ' | uniq %}
    {% endif %}
{% endfor %}

<div class="product-details">
    <div class="actions">
        {% assign hide_default_title = false %}
        {% if product.variants.size == 1 and product.variants.first.title contains 'Default' %}
            {% assign hide_default_title = true %}
        {% endif %}

        {% assign show_variants = 'hidden' %}
        {% if product.available %}
            {% assign show_variants = '' %}
        {% endif %}

        {% assign needsToShowStandardVariant = true %}
        {% if product.type == 'Carpet' or product.type == 'Carpets' or product.type == 'Vinyl' or product.type == 'Artificial Grass' %}
            {% assign needsToShowStandardVariant = false %}
        {% endif %}
        {% if product.type == 'Laminate' or product.type == 'LVT' %}
            {% assign needsToShowStandardVariant = false %}
        {% endif %}
        
        {% if product.type == 'Rugs' or product.type == 'Mattress' or product.type == 'Bed' or product.type == 'Headboard' %}
            {% assign needsToShowStandardVariant = false %}
        {% endif %}
        {% unless product.type == 'Rugs' or product.type == 'Mattress' or product.type == 'Bed' or product.type == 'Headboard' %}
            <div id="product-variants" class="numberOfOptions{{ product.options.size }} {% if hide_default_title %}hidden{% endif %} {{ show_variants }}{% if needsToShowStandardVariant %} standardProduct{% endif %}">
                {% if needsToShowStandardVariant %}
                    <div class="option option-single">
                {% endif %}
                    {% if product.options.size == 1 and product.options.first != 'Title' %}
                        {% if needsToShowStandardVariant %}
                            <h2>{{ product.options.first }}</h2>
                        {% else %}
                            <label style="display:block">{{ product.options.first }}</label>
                        {% endif %}
                    {% elsif product.options.size > 1 and needsToShowStandardVariant %}
                        <h2>Options</h2>
                    {% endif %}

                    <div class="content">
                        <select id="product-select" name="id" style="display: none;">
                            {% for variant in product.variants %}
                                <option {% if variant == product.selected_or_first_available_variant %} selected {% endif %} value="{{ variant.id }}" data-colour="{{ variant.option1 }}" data-size="{{variant.option2}}" data-quantity="{{ variant.inventory_quantity }}" data-deliveryEstimate="{{ variant.metafields.Juno.Delivery_time }}"  data-stockLevel="{{ variant.metafields.Juno.lowstock }}" data-inStock="{{variant.metafields.juno.is_in_stock}}" data-price="{{ variant.price }}">
                                    {{ variant.title }}
                                </option>
                            {% endfor %}
                        </select>
                        {% for option in product.options_with_values %}
                            {% assign order = option.position | minus: 1  %}
                            
                            <div class="selector-wrapper">
                                <label for="product-select-option-{{ order }}">{{ option.name }}</label>
                                <select class="single-option-selector" id="product-select-option-{{ order }}" data-option="option{{ order }}">
                                    {% for value in option.values %}
                                        <option value="{{ value | escape }}">{{ value }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        {% endfor %}  
                            
                            <script data-unavailable="{{ unavailable }}" data-product-type="{{ product.type }}" data-sold-out="{{ sold_out }}" data-hide-default-title="{{hide_default_title}}" data-product-title="{{ product.title }}" data-money-format="{{ shop.money_format }}" type="application/json" id="ProductVariants">
                                {{ product.variants | json }}
                            </script>
                        
                        {% if product.metafields.custom.colours %}
                            <div class="selector-wrapper" id="custom-product-colours" style="margin-top: 15px;"></div>
                            <script>
                                let coloursEl  = document.getElementById('custom-product-colours')
                                let colours = "{{ product.metafields.custom.colours }}"
                                let coloursArray = colours.split(',')
                                
                                if(Array.isArray(coloursArray)) {
                                    let coloursDropdown = '<label for="custom-product-colours">Colour</label><select id="custom-product-colours" name="properties[Colour]">'
                                    for (let index = 0; index < coloursArray.length; index++) {
                                        const colour = coloursArray[index];
                                        coloursDropdown += `<option value="${colour}">${colour}</option>`;
                                    }
                                    coloursDropdown += '</select>';

                                    coloursEl.innerHTML = coloursDropdown
                                }
                                
                            </script>
                            
                        {% endif %}   
                    </div>

                {% if needsToShowStandardVariant %}
                    </div>
                {% endif %}
            </div>
        {% endunless %}
        
        {% unless needsToShowStandardVariant %}
            <div class="option option-colour" data-select-option="{{ '#product-select-option-' | append: position_option_colors }}">
                
                {% if value_colors.size > 0 %}
                    {% unless product.title contains " - " and value_colors.size == 1 %}
                        {% if product.type == 'Rugs' %}
                            <h2>Options</h2>
                        {% else %}
                            <h2>Colour</h2>
                        {% endif %}
                        
                        <div class="swatch-colours swatch-colours__product">
                            <div id="select-option-colour" class="select">
                                <label>Choose Your Colour</label>
                                <ul>
                                    {% for value_color in value_colors %}
                                        {% assign color = value_color | strip %}
                                        <li data-value="{{ color }}" class="js-get-colour-value">
                                            {% assign displayedColor = '' %}
                                            {% for variant in product.variants %}
                                                {% for option in variant.options %}
                                                    {% if option == color %}
                                                        {% unless displayedColor contains color %}
                                                            {% assign displayedColor = displayedColor | append: '|' | append: color %}
                                                            <span class="data" data-id="{{variant.id}}" data-quantity="{{ variant.inventory_quantity }}" data-stockLevel="{{ variant.metafields.Juno.lowstock }}" data-deliveryEstimate="{{ variant.metafields.Juno.Delivery_time }}"><img src="{{ variant.image.src | img_url: '40x40', crop: 'center' }}" alt="{{ color }}"/>{{ color }}</span>
                                                        {% endunless %}
                                                        {% break %}
                                                    {% endif %}
                                                {% endfor %}
                                            {% endfor %}
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                            <ul class="grid">
                                {% for value_color in value_colors %}
                                    {% assign color = value_color | strip %}
                                    <li data-value="{{ color }}" class="js-get-colour-value">
                                        
                                        {% assign displayedColor = '' %}
                                        {% for variant in product.variants %}
                                            {% for option in variant.options %}
                                                {% if option == color %}
                                                    {% unless displayedColor contains color %}
                                                        {% assign displayedColor = displayedColor | append: '|' | append: color %}
                                                        <span class="data" data-id="{{variant.id}}" data-quantity="{{ variant.inventory_quantity }}" data-stockLevel="{{ variant.metafields.Juno.lowstock }}" data-deliveryEstimate="{{ variant.metafields.Juno.Delivery_time }}">
                                                            <picture>
                                                                <source media="(min-width: 768px)" srcset="{{ variant.image.src | img_url: '40x40', crop: 'center' }}" >
                                                                <source srcset="{{ variant.image.src | img_url: '80x80', crop: 'center' }}" >
                                                                <img src="{{ variant.image.src | img_url: '40x40', crop: 'center' }}" alt="{{ color }}"/>
                                                            </picture>
                                                        </span>
                                                        {% break %}
                                                    {% endunless %}
                                                {% endif %}
                                            {% endfor %}
                                        {% endfor %}
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endunless %}
                {% endif %}
                {% if product.type == 'Rugs' or product.type == 'Mattress' or product.type == 'Bed' or product.type == 'Headboard' %}
                    
                    <div id="product-variants" class="numberOfOptions{{ product.options.size }} {% if hide_default_title %}hidden{% endif %} {{ show_variants }} standardProduct option-single">
                        
                            <select id="product-select" name="id" style="display: none;">
                                {% for variant in product.variants %}
                                    <option {% if variant == product.selected_or_first_available_variant %} selected {% endif %} value="{{ variant.id }}" data-colour="{{ variant.option1 }}" data-size="{{variant.option2}}" data-quantity="{{ variant.inventory_quantity }}" data-deliveryEstimate="{{ variant.metafields.Juno.Delivery_time }}"  data-stockLevel="{{ variant.metafields.Juno.lowstock }}" data-inStock="{{variant.metafields.juno.is_in_stock}}" data-price="{{ variant.price }}">
                                        {{ variant.title }}
                                    </option>
                                {% endfor %}
                            </select>
                        

                            {% for option in product.options_with_values %}
                                {% assign order = option.position | minus: 1  %}
                                {% assign isColour = false  %}
                                {% if option.name contains 'Colour' %}
                                    {% assign isColour = true  %}
                                {% endif %}
                                
                                {% if isColour == false %}
                                    <h2 style="order: {{ order }}">{{option.name}}</h2>
                                {% endif %}
                                <div style="order: {{ order }}" data-order="{{ order }}" class="content {% if isColour %} colour-dropdown {% endif %}">
                                    <div class="selector-wrapper">
                                        <label for="product-select-option-{{ order }}">{{ option.name }}</label>
                                        <select class="single-option-selector" id="product-select-option-{{ order }}" data-option="option{{ order }}">
                                            {% for value in option.values %}
                                                <option value="{{ value | escape }}">{{ value }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>
                            {% endfor %}  
                            
                            <script data-unavailable="{{ unavailable }}" data-product-type="{{ product.type }}" data-sold-out="{{ sold_out }}" data-hide-default-title="{{hide_default_title}}" data-product-title="{{ product.title }}" data-money-format="{{ shop.money_format }}" type="application/json" id="ProductVariants">
                                {{ product.variants | json }}
                            </script>
                            
                    </div>
                {% endif %}
                {% assign product_colour = product.title | split: " - " | first | strip %}
                {% assign product_title = product.title | split: " - " | last | strip %}
                {% assign product_handle = product.handle %}

                {% assign hasSomeColours = true %}
                {% if value_colors == blank %}
                    {% assign hasSomeColours = false %}
                {% endif %}
                {% if value_colors.size < 2 %}
                    {% assign hasSomeColours = false %}
                {% endif %}

                {% if product.title contains " - " and hasSomeColours == false %}
                    <h2>Colour</h2>
                    <div class="swatch-colours swatch-colours__product">
                        <div id="select-option-colour" class="select">
                            {% assign first_image = product.images | first %}
                            <label>
                                <span><img src="{{ first_image | img_url: '40x40', crop: 'center' }}" alt="{{ product_colour }}"/>{{ product_colour }}</span>
                            </label>
                            <ul>
                                {% assign other_products = '' %}
                                {% for collection in product.collections %}
                                    {% for inner_product in collection.products %}
                                        {% if inner_product.title contains product_title %}
                                            {% if inner_product.handle != product_handle %}
                                                {% unless other_products contains inner_product.handle %}
                                                    {% assign first_image = inner_product.images | first %}
                                                    {% assign other_products = other_products | append: "," | append: inner_product.handle %}
                                                    {% assign product_colour = inner_product.title | split: " - " | first | strip %}
                                                    <li data-value="{{ product_colour }}">
                                                        <a href="/products/{{ inner_product.handle }}">
                                                            <span><img src="{{ first_image | img_url: '40x40', crop: 'center' }}" alt="{{ product_colour }}"/>{{ product_colour }}</span>
                                                        </a>
                                                    </li>
                                                {% endunless %}
                                            {% endif %}
                                        {% endif %}
                                    {% endfor %}
                                {% endfor %}
                            </ul>
                        </div>
                        <ul class="grid">
                            {% assign first_image = product.images | first %}
                            <li>
                                <span>
                                    <picture>
                                        <source media="(min-width: 768px)" srcset="{{ first_image | img_url: '40x40', crop: 'center' }}" >
                                        <source srcset="{{ first_image | img_url: '80x80', crop: 'center' }}" >
                                        <img src="{{ first_image | img_url: '40x40', crop: 'center' }}" alt="{{ product_colour }}"/>
                                    </picture>

                                    {{ product_colour }}
                                </span>
                            </li>
                            {% assign other_products = '' %}
                            {% for collection in product.collections %}
                                {% for inner_product in collection.products %}
                                    {% if inner_product.title contains product_title %}
                                        {% if inner_product.handle != product_handle %}
                                            {% unless other_products contains inner_product.handle %}
                                                {% assign first_image = inner_product.images | first %}
                                                {% assign other_products = other_products | append: "," | append: inner_product.handle %}
                                                {% assign product_colour = inner_product.title | split: " - " | first | strip %}
                                                <li data-value="{{ product_colour }}">
                                                    <a href="/products/{{ inner_product.handle }}">
                                                        <span>
                                                            <picture>
                                                                <source media="(min-width: 768px)" srcset="{{ first_image | img_url: '40x40', crop: 'center' }}" >
                                                                <source srcset="{{ first_image | img_url: '80x80', crop: 'center' }}" >
                                                                <img src="{{ first_image | img_url: '40x40', crop: 'center' }}" alt="{{ color }}"/>
                                                                {{ product_colour }}
                                                            </picture>
                                                        </span>
                                                    </a>
                                                </li>
                                            {% endunless %}
                                        {% endif %}
                                    {% endif %}
                                {% endfor %}
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
            </div>
            <!-- .colour -->
        {% endunless %}
        <script>
            var allImageVariants = [];{% for variant in product.variants %}allImageVariants['{{ variant.title }}'] = '{{ variant.image.src | img_url: "1280x1280" }}';{% endfor %}
        </script>

        <div id="product-add">

            <!-- Additional Swatches using tag "customdropdown_" for single product page -->

            {% for tag in product.tags %}
                {% if tag contains 'customdropdown_' %}
                    {% assign productName = tag | replace: 'customdropdown_', '' %}
                    {% assign productData = all_products[productName] %}
                    {% break %}
                {% endif %}
            {% endfor %}

            <!-- Additional Swatches using tag "defaultvariant_" to selecte specific variant -->

            {% for tag in product.tags %}
                {% if tag contains 'defaultvariant_' %}
                    {% assign defaultVariantSelect = tag | replace: 'defaultvariant_', '' %}
                {% endif %}
            {% endfor %}

            {%- if productName -%}
                <div class="option option-colour" data-select-option="{{ '#product-select-option-' | append: position_option_colors }}">
                    {% if productData.type != 'Rugs' and productData.type != 'Mattress' and productData.type != 'Headboard' and productData.type != 'Bed' %}
                    {% assign values = productData.variants | map: "option1" | uniq %}
                        <h2>Colour</h2>
                    {% endif %}

                    <!-- Check if Assigned tag Variant value match from variant loop end -->

                    {% for option in productData.options_with_values %}
                        {% if option.name == "Colour" %}
                            {% for value in option.values %}
                                {% if defaultVariantSelect == value %}
                                    {% assign defaultVariantSelection = "" %}
                                    {% break %}
                                {% endif %}
                            {% endfor %}
                        {% endif %}
                    {% endfor %}
                    <!-- Check if Assigned tag Variant value match from variant loop end -->

                    <div class="swatch-colours swatch-colours-new swatch-colours__product">
                        <div id="select-option-colour-custom-dropdown" class="select">
                            <label>
                                {% for option in productData.options_with_values %}
                                    {% if option.name == "Colour" %}

                                        <!-- Default Dropdown Selected Variant Html End -->
                                        {% for value in option.values %}

                                            {% if defaultVariantSelection %}
                                                {% if defaultVariantSelect == value %}
                                                    <span class="data">
                                                        {% for color_value in values %}
