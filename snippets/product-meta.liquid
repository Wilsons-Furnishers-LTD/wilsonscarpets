{% assign GTINexist = '' %}
{% for tag in product.tags %}
    {% if tag contains 'identifier_exists_' %}
        {% assign GTINexist = tag | replace: 'identifier_exists_', '' %}
    {% endif %}
{% endfor %}

<meta itemprop="url" content="{{ shop.url }}{{ product.url }}"/>
<meta itemprop="image" content="https:{{ product | img_url: '1280x1280' }}"/>
{% if product.available %}
    <meta itemprop="sku" content="{{ product.first_available_variant.sku }}"/>
{% else %}
    <meta itemprop="sku" content="{{ product.variants.first.sku}}" />
{% endif %}

<span itemprop="brand" itemtype="https://schema.org/Brand" itemscope><meta itemprop="name" content="{{ product.vendor }}" /></span>

<div itemprop="offers" itemtype="https://schema.org/Offer" itemscope>
    {% assign variant = product.selected_or_first_available_variant %}
    <meta itemprop="url" content="{{ shop.url }}{{ product.url }}"/>
    <meta itemprop="priceCurrency" content="{{ shop.currency }}"/>
    <meta itemprop="itemCondition" content="https://schema.org/NewCondition" />
    <meta itemprop="price" content="{{ variant.price | money_without_currency }}" />
    <meta itemprop="priceValidUntil" content="{{ "now" | date: "%Y" | plus: 1 }}-11-20" />

    {% if product.available %}
    <meta itemprop="availability" content="https://schema.org/InStock" />
    {% else %}
    <link itemprop="availability" href="https://schema.org/OutOfStock"/>
    {% endif %}
</div>