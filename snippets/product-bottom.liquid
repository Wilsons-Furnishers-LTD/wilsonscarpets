{% assign unavailable = 'Unavailable' %}


{% for tag in product.tags %}
    {% if tag contains 'parent_' %}
        {% assign parentHandle = tag | replace: 'parent_', '' %}
        <script>
            window.location = "/products/{{ parentHandle }}";
        </script>
    {% endif %}
    {% if tag contains 'RRP_' %}
        {% assign RRPPrice = tag | replace: 'RRP_', '' | plus: 0 %}
    {% endif %}
    {% if tag contains 'Pack Size (M²)_' %}
        {% assign packSizePerSQM = tag | replace: 'Pack Size (M²)_', '' | split: 'm' | first | plus: 0 %}
    {% endif %}
{% endfor %}

<script>
    // activeVariant = -1;
    variantsAndPrices = [];
    variantsAndStock = [];
    var variantsAndImages = [];
    var preLoadImages = [];
    var productJSON = {{ product | json }}
    var defaultImagePath = "{{ product.selected_or_first_available_variant.image.src | img_url: '1280x1280' }}";
    
    {% for variant in product.variants %}
        variantsAndPrices[{{ variant.id }}] = {'price': {{ variant.price }},{% if variant.compare_at_price %} 'compare_at_price' : {{ variant.compare_at_price }}{% else %}'compare_at_price' : {{ variant.price }}{% endif %}};
        variantsAndStock[{{ variant.id }}] = {% if variant.metafields.juno.is_in_stock == 0 or variant.metafields.juno.is_in_stock == "0" %}'false'{% else %}'true'{% endif %};

        {% assign temp_thumb = product.featured_image | img_url: '80x80', crop: 'center' | append: '|'  %}
        {% assign temp_large = product.featured_image | img_url: '860x860' | append: '|'%}
        {% for i in (1..11) %}
            {% assign variant_photo = 'photo_' | append: forloop.index %}
            {% if variant.metafields.juno[variant_photo] != blank %}
            {% assign thumb_image = variant.metafields.juno[variant_photo] | split: "/" | last | file_img_url: '80x80', crop: 'center' %}
            {% assign large_image = variant.metafields.juno[variant_photo] | split: "/" | last | file_img_url: '860x860' %}
            {% assign temp_thumb = temp_thumb | append: thumb_image | append: '|' %}
            {% assign temp_large = temp_large | append: large_image | append: '|' %}
            {% endif %}
        {% endfor %}
        variantsAndImages[{{ variant.id }}] = {'thumbs': {{ temp_thumb | split: "|" | json }}, 'large': {{temp_large | split: "|" | json}} }

    {% endfor %}

    try{
        if(productJSON.variants.length){
            productJSON.variants.forEach(variant => {
                if(variantsAndImages[variant.id]['thumbs'][1]){
                    preLoadImages.push(variantsAndImages[variant.id]['thumbs'][1].replace('_80x80_crop_center', '_600x600'));
                    preLoadImages.push(variantsAndImages[variant.id]['thumbs'][1].replace('_80x80_crop_center', '_860x860'));
                }
            })
        }
        Shopify.Image.preload(preLoadImages);
    }catch(err){
        console.log(err);
    }


    function updateSampleAvailability() {
        // check if this active variant has a sample available or not:
        // ## john
        var activeVariant = jQuery('#product-select option:selected').val().trim();

        if (freeSampleVariantsAvailability[activeVariant] == 'no') {
            jQuery('#orderFreeSample').addClass('disabled');
        } else {
            jQuery('#orderFreeSample').removeClass('disabled');
        }
    }

    function updateSampleVariant() {
        {% if product.options.size > 1 %}
            if (jQuery('#selectWrapperColour .single-option-selector').length > 0) {
                var colour = jQuery('#selectWrapperColour .single-option-selector option:selected').text().trim();
            } else {
                var colour = jQuery('#product-select option:selected').text().split(" / ")[0].trim();
            }

            if (freeSampleVariants.hasOwnProperty(colour)) {
                jQuery("#orderFreeSample").attr("data-variant", freeSampleVariants[colour]);
            } else {
                jQuery("#orderFreeSample").attr("data-variant", jQuery("#orderFreeSample").data("defaultvariant"));
            }
            // update image as well:
            var activeVariant = jQuery('#product-select option:selected').text().trim();

            if (typeof allImageVariants !== 'undefined' && allImageVariants.hasOwnProperty(activeVariant)) {
                variantImagePath = allImageVariants[activeVariant];
            } else {
                variantImagePath = defaultImagePath;
            }
        {% endif %}
    }

    function updateMetres() { // convert this to metres:
        var thisFeetQuantity = jQuery('#userLengthFeet').val();
        if (isNaN(thisFeetQuantity)) {
            thisFeetQuantity = 0;
        }
        var thisInchesQuantity = jQuery('#userLengthInches').val();
        if (isNaN(thisInchesQuantity)) {
            thisInchesQuantity = 0;
        }
        // convert feet to inches, and sum
        thisFeetQuantity = parseInt(thisFeetQuantity) * 12;
        thisInchesQuantity = parseInt(thisInchesQuantity);
        thisInchesQuantity += thisFeetQuantity;
        var convertedMetres = thisInchesQuantity / 39.370;
        jQuery('#userLength').val(convertedMetres);
        updatePrice();
    }

    function updatePrice() {
        var length = 1;
        var minQuantity = null;
        {% if product.type == 'Carpet' or product.type == 'Carpets' or product.type == 'Vinyl' or product.type == 'Artificial Grass' %}
            // round up 'quantity':
            var thisQuantity = jQuery('#userLength').val();
            minQuantity = jQuery('#userLength').data('min');

            if (isNaN(thisQuantity) || thisQuantity == "") {
                thisQuantity = minQuantity;
            }
            // round to 2 decimal places:
            var t = thisQuantity.toString();
            thisQuantity = (t.indexOf(".") >= 0) ? (t.substr(0, t.indexOf(".")) + t.substr(t.indexOf("."), 3)) : t;
            length = Number(thisQuantity);
        {% else %}
            var thisQuantity = jQuery('#quantity').val();
        {% endif %}

        // Whether the variant is in stock or not, we can update the price and compare at price.
        var activeVariant = jQuery('#product-select').val();
        var option_size = jQuery('.option-size');
        
        if (option_size.length) {
            var select_option_size = jQuery(option_size.data('select-option'));
            if (select_option_size.val()) {
                var width = parseFloat(select_option_size.val());
            } else { // in case no colour is selected yet:
                var width = parseFloat(jQuery('.option-size select').val());
            }
        }

        if (jQuery('#product-variants').hasClass('standardProduct')) { // standard product:
            width = 1;
        }
        var totalSquareMetres = length * width;
        if (isNaN(totalSquareMetres)) {
          totalSquareMetres = 0;
        }
        jQuery('#totalAreaM2').html("<p itemprop='price'>Total Area <span>" + totalSquareMetres.toFixed(2) + "m<sup>2</sup></span></p>");
        var basePrice = variantsAndPrices[activeVariant].price;
        var thisPrice = basePrice * width;
        var thisFinalPrice = thisPrice * length;
        var thisCompareAtPrice = variantsAndPrices[activeVariant].compare_at_price * width;
        var totalLabel = "Total";
        {% if needsToShowStandardVariant %}
            var totalLabel = "Price";
        {% endif %}

        if (thisCompareAtPrice > thisPrice) {
            jQuery('#product-price').html(totalLabel + ' <span class="product-price on-sale" itemprop="price" data-price="' + Math.round(thisPrice * length) + '">' + Shopify.formatMoney(thisPrice * length, "{{ shop.money_format }}") + '</span>' + '&nbsp;<s class="product-compare-price">' + Shopify.formatMoney(thisCompareAtPrice * length, "{{ shop.money_format }}") + '</s>');
        } else {
            jQuery('#product-price').html(totalLabel + ' <span class="product-price" itemprop="price" data-price="' + Math.round(thisPrice * length) + '">' + Shopify.formatMoney(thisPrice * length, "{{ shop.money_format }}") + '</span>');
        }

        jQuery('#totalAreaM2').html("<p itemprop='price'>Total Area <span>" + totalSquareMetres + "m<sup>2</sup></span></p>");
        if (minQuantity != null) {
            if (thisQuantity == minQuantity) {
                if (isTyping) {
                    if (isZero) {
                        jQuery('#userLength').val("");
                    } else {
                        jQuery('#userLength').val(minQuantity);
                    }
                } else {
                    jQuery('#userLength').val("");
                }
            } else {
                jQuery('#userLength').val(thisQuantity);
            }
        }
        // update the variant for the Free sample:
        updateSampleVariant();
        window.KlarnaThemeGlobals.data_purchase_amount = thisFinalPrice;
    }

    var selectCallback = function (variant, selector) {
        if (variant) {
        // Selected a valid variant that is available.
            if (variant.available) { // Enabling add to cart button.

                // If item is backordered yet can still be ordered, we'll show special message.
                if (variant.inventory_management && variant.inventory_quantity <= 0) {
                    jQuery('#selected-variant').html(
                        {{ product.title | json }}{% unless hide_default_title %} + ' - ' + variant.title{% endunless %}
                    );
                    jQuery('#backorder').removeClass("hidden");
                } else {
                    jQuery('#backorder').addClass("hidden");
                }
            } else { // Variant is sold out.
                jQuery('#backorder').addClass('hidden');
                jQuery('#AddToCart').val({{ sold_out | json }}).addClass('disabled').prop('disabled', true);
            }
            updatePrice();

            {% if product.type == 'Carpet' or product.type == 'Carpets' or product.type == 'Vinyl' or product.type == 'Artificial Grass' %}
                updateSampleAvailability();
            {% endif %}
            
            if(jQuery('#first_load').val() != 'false' || !jQuery('.option-colour #select-option-colour').length) {
                var selectedOption = jQuery('#product-select').find('option:selected'),
                    stock_level = selectedOption.data('stocklevel'),
                    deliveryestimate = selectedOption.data('deliveryestimate'),
                    variant_qty = selectedOption.data('quantity'),
                    is_in_stock = selectedOption.data('instock'),
                    variantid = selectedOption.attr('value');

                if(is_in_stock > 0 ) {
                    if(stock_level == 'Yes') {
                        jQuery('#stockLevel').removeClass().addClass('limitedStock').html('<i class="icon-instock"></i> Order Now');
                        jQuery('#properties_stockLevel').val('Order Now');
                    }
                    else {
                        jQuery('#stockLevel').removeClass().addClass('inStock').html('<i class="icon-instock"></i> In stock');
                        jQuery('#properties_stockLevel').val('In stock');
                    }
                    jQuery('#carpetAddToCart').removeClass('disabled').removeAttr('disabled').html('Add to Basket');
                    jQuery('#AddToCart').removeClass('disabled').removeAttr('disabled').html('Add to Basket');
                    jQuery('#fake-add-card-btn').removeClass('disabled').removeAttr('disabled').html('Add to Basket');
                }
                else {
                    jQuery('#stockLevel').removeClass().addClass('outOfStock').html('<i class="icon-outofstock"></i> Out of stock');
                    jQuery('#properties_stockLevel').val('Out of stock');
                    jQuery('#carpetAddToCart').addClass('disabled').attr('disabled', true).html('Out of Stock');
                    jQuery('#AddToCart').addClass('disabled').attr('disabled', true).html('Out of Stock');
                    jQuery('#fake-add-card-btn').addClass('disabled').attr('disabled', true).html('Out of Stock');
                }

                if (deliveryestimate) {
                    jQuery('#deliveryEstimate').html('<span class="location__icon icon icon"><img src="{{ 'icon-location.svg' | asset_url }}" alt="location"></span> ' + deliveryestimate);
                    jQuery('#properties_deliveryEstimate').val(deliveryestimate);
                }

                jQuery('#properties_variantID').val(variantid);
            }
            jQuery('#first_load').val(true);
        } else {
            // variant doesn't exist.
            jQuery('#backorder').addClass('hidden');
            jQuery('#AddToCart').val({{ unavailable | json }}).addClass('disabled').prop('disabled', true);
        }
    };


