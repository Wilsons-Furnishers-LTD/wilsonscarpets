<!doctype html>
<html
  class="no-js"
  lang="{{ shop.locale }}"
  itemscope
  itemtype="https://schema.org/WebPage">

<head>

<meta charset="utf-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>
{{ page_title | replace: ' -tag:Sample', '' }}
{% if current_tags %}
&ndash; tagged "{{ current_tags | join: ', ' }}"
{% endif %}
{% if current_page != 1 %}
&ndash; Page {{ current_page }}
{% endif %}
{% unless page_title contains shop.name %}
&ndash; {{ shop.name }}
{% endunless %}
</title>


{% if page_description %}
<meta name="description" content="{{ page_description | escape }}">
{% elsif template.name == 'product' %}
<meta name="description" content="Shop {{ product.title }} {{ product.type }} at {{ shop.name }}">
{% elsif template.name == 'collection' %}
<meta name="description" content="Discover {{ collection.title }} at {{ shop.name }}">
{% elsif shop.description %}
<meta name="description" content="{{ shop.description }}">
{% endif %}


{% render 'robots-canonical-url' %}


<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">

<link rel="preconnect" href="//cdn.shopify.com">

{% if template contains 'noindex' %}
<meta name="robots" content="noindex">
{% endif %}



{% liquid
  render 'open-graph-tags'
  render 'twitter-card'
%}


{{ content_for_header }}



<script src="{{ 'jquery.min.js' | asset_url }}"></script>
<script src="{{ 'jquery-ui.min.js' | asset_url }}"></script>
<script src="{{ 'owl.carousel.js' | asset_url }}"></script>

<script src="{{ 'shopify_common.js' | shopify_asset_url }}" defer></script>


{% if template.name contains 'customers' %}
{{ 'customer_area.js' | shopify_asset_url | script_tag }}
{% endif %}


<script src="{{ 'option_selection.js' | shopify_asset_url }}"></script>



<link rel="apple-touch-icon"
href="{{ 'wc-logo.png' | asset_url }}">

<link rel="shortcut icon"
href="{{ 'medichecks_favicon_256x256.png' | asset_url }}">


<link rel="manifest"
href="{{ 'site.webmanifest' | asset_url }}">



<link href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,600,700,900%7CMaterial+Icons&display=swap"
rel="stylesheet">


<link rel="stylesheet"
href="https://use.typekit.net/yay0ohu.css">


<meta name="google-site-verification"
content="iFZf-C-RcT5jTo819oqNN5divbHwKSobCyIXDV45jEU">



