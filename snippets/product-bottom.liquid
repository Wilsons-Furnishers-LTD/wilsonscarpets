  function setSelectedSize(value) {
    sessionStorage.setItem('selectedSize', value);
  }

  function initSelectedSize() {
    const selectedSize = sessionStorage.getItem('selectedSize');

    const sizeSelectors = document.querySelectorAll('.size .measurementSelect .selectWrapper select');

    if (selectedSize && sizeSelectors.length > 0) {
      sizeSelectors.forEach((select) => {
        const optionExists = Array.from(select.options).some((option) => option.value === selectedSize);

        if (optionExists) {
          select.value = selectedSize;
          select.dispatchEvent(new Event('change'));
        }
      });
    }
  }

</script>
