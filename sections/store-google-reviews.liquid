{{ 'store-google-reviews.css' | asset_url | stylesheet_tag }}
{%- comment -%}
    Store Google reviews: a centred heading and a row of review cards (stars, text, reviewer initial, name, date)
    for the current store, loaded live in the browser with the Places API (New) - Place.fetchFields(). Google returns up to 5.
    The cards sit in rows (5 across on desktop), centred when a row isn't full.

    Needs, on the store_page metaobject definition:
      google_place_id - single line text, the store's Google Place ID (starts "ChIJ...").
                        Find it at https://developers.google.com/maps/documentation/places/web-service/place-id
    And on the Google Cloud project for the API key: "Places API (New)" enabled.

    The section renders nothing on the storefront if the store has no Place ID or Google returns no reviews.
    The Maps API is loaded by snippets/store-google-maps-loader.liquid (same key as the store locator).
    Styles: src/styles/store-google-reviews/_index.scss -> assets/store-google-reviews.css (npm run build)
{%- endcomment -%}
{%- assign store = metaobject -%}
{%- assign place_id = store.google_place_id.value | strip -%}

{% if place_id != blank %}
    <div class="store-reviews" id="StoreReviews-{{ section.id }}" data-section-id="{{ section.id }}" data-section-type="store-google-reviews" hidden>
        <div class="wrapper">
            <div class="store-reviews__header">
                {% if section.settings.heading != blank %}
                    <h2 class="store-reviews__heading">{{ section.settings.heading | escape }}</h2>
                {% endif %}
                {%- comment -%} Opens all of the store's reviews on Google {%- endcomment -%}
                <a class="store-reviews__all" href="https://search.google.com/local/reviews?placeid={{ place_id | url_encode }}" target="_blank" rel="noopener">
                    See all reviews on Google<span class="visually-hidden"> (opens in a new tab)</span>
                </a>
            </div>

            <div class="store-reviews__list" role="list" data-list></div>
        </div>
    </div>

    {% render 'store-google-maps-loader' %}
    <script>
        (function () {
            var root = document.getElementById('StoreReviews-{{ section.id }}');
            if (!root) return;

            var placeId = {{ place_id | json }};
            var maxReviews = {{ section.settings.max_reviews }};
            var minRating = {{ section.settings.min_rating }};

            var STAR = 'M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z';

            // Five stars with the filled layer clipped to the rating, e.g. 4.6 -> 92%
            function stars(rating) {
                var el = document.createElement('span');
                el.className = 'store-reviews__star-row';
                el.setAttribute('role', 'img');
                el.setAttribute('aria-label', rating + ' out of 5 stars');
                var row = '';
                for (var i = 0; i < 5; i++) row += '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="' + STAR + '"/></svg>';
                el.innerHTML =
                    '<span class="store-reviews__star-row-empty">' + row + '</span>' +
                    '<span class="store-reviews__star-row-full" style="width:' + Math.max(0, Math.min(100, rating / 5 * 100)) + '%">' + row + '</span>';
                return el;
            }

            function text(tag, className, value) {
                var el = document.createElement(tag);
                el.className = className;
                el.textContent = value || '';
                return el;
            }

            function reviewCard(review) {
                var author = review.authorAttribution || {};
                var name = author.displayName || 'Google user';
                var li = document.createElement('div');
                li.className = 'store-reviews__card';
                li.setAttribute('role', 'listitem');

                li.appendChild(stars(review.rating || 0));
                if (review.text) li.appendChild(text('p', 'store-reviews__text', review.text));

                var foot = document.createElement('div');
                foot.className = 'store-reviews__author';
                // Reviewer's Google profile picture if they have one, otherwise (or if it fails to load) their initial
                var avatar = text('span', 'store-reviews__avatar', name.trim().charAt(0).toUpperCase());
                avatar.setAttribute('aria-hidden', 'true');
                if (author.photoURI) {
                    var photo = document.createElement('img');
                    photo.src = author.photoURI;
                    photo.alt = '';
                    photo.width = 28;
                    photo.height = 28;
                    photo.loading = 'lazy';
                    photo.referrerPolicy = 'no-referrer';
                    photo.onerror = function () { photo.remove(); };
                    avatar.appendChild(photo);
                }
                foot.appendChild(avatar);

                var who = document.createElement('div');
                var nameEl;
                if (author.uri) {
                    nameEl = text('a', 'store-reviews__name', name);
                    nameEl.href = author.uri;
                    nameEl.target = '_blank';
                    nameEl.rel = 'noopener nofollow';
                } else {
                    nameEl = text('span', 'store-reviews__name', name);
                }
                who.appendChild(nameEl);
                var date = review.relativePublishTimeDescription;
                who.appendChild(text('span', 'store-reviews__date', (date ? date + ' \u00b7 ' : '') + 'Google'));
                foot.appendChild(who);
                li.appendChild(foot);
                return li;
            }

            async function init() {
                try {
                    var places = await google.maps.importLibrary('places');
                    var place = new places.Place({ id: placeId });
                    await place.fetchFields({ fields: ['reviews'] });

                    var reviews = (place.reviews || [])
                        .filter(function (r) { return (r.rating || 0) >= minRating; })
                        .slice(0, maxReviews);
                    if (!reviews.length) return;

                    var list = root.querySelector('[data-list]');
                    reviews.forEach(function (r) { list.appendChild(reviewCard(r)); });

                    root.hidden = false;
                } catch (e) {
                    // Wrong Place ID, Places API (New) not enabled, or the request was blocked - leave the section hidden
                    console.warn('Store Google Reviews: could not load reviews', e);
                }
            }

            window.storeLoadGoogleMaps(init);
        })();
    </script>
{% elsif request.design_mode %}
    <div class="store-reviews">
        <div class="wrapper">
            <p class="store-reviews__notice">
                Store Google Reviews: add this store's Google Place ID to its <strong>google_place_id</strong> field to show its reviews.
                This message only shows in the theme editor.
            </p>
        </div>
    </div>
{% endif %}

{% schema %}
    {
        "name": "Store Google Reviews",
        "class": "index-section",
        "settings": [
            {
                "type": "text",
                "id": "heading",
                "label": "Heading",
                "default": "Google Reviews"
            },
            {
                "type": "range",
                "id": "max_reviews",
                "label": "Number of reviews",
                "info": "Google returns up to 5 reviews.",
                "min": 1,
                "max": 5,
                "step": 1,
                "default": 5
            },
            {
                "type": "range",
                "id": "min_rating",
                "label": "Only show reviews rated at least",
                "min": 1,
                "max": 5,
                "step": 1,
                "default": 4
            }
        ],
        "presets": [{
            "name": "Store Google Reviews",
            "category": "Text"
        }]
    }
{% endschema %}
