{% case block.settings.add_border_top %}
	{% when 'add_border_top_yes' %}
		{%- assign border_top = 'border-top' -%}
	{% when 'add_border_top_no' %}
		{%- assign border_top = '' -%}
{% endcase %} 

{% case block.settings.add_border_bottom %}
	{% when 'add_border_bottom_yes' %}
		{%- assign border_bottom = 'border-bottom' -%}
	{% when 'add_border_bottom_no' %}
		{%- assign border_bottom = '' -%}
{% endcase %}  

<div data-section-id="{{ section.id }}" data-section-type="banner" class="bannergrid four icon txt-section">
    <div class="wrapper">
        <div class="container {{ border_bottom }} {{ border_top }}">
            {% if block.settings.title != blank %}
				<h2 class="title-section">{{ block.settings.title | escape }}</h2>
			{% endif %}
            <div class="row">
                <div class="col-wide-3">
                    <div class="icon">
                    {% if block.settings.icon_1 %}
                        {{ block.settings.icon_1 }}
                    {% else %}
                        {% if block.settings.image_1 %}
                            <picture>
                                <img src="{{ block.settings.image_1 | img_url: '1920x' }}" alt="" />
                            </picture>
                        {% else %}
                            <span class="placeholder-background">
                                {% capture current %}{% cycle 1, 2 %}{% endcapture %}
                                {{ 'lifestyle-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                            </span>
                        {% endif %}
                    {% endif %}   
                    </div> 
                    <div class="text-content">
                        {% unless block.settings.title_1 == blank %}
                        <h2 class="title">{{ block.settings.title_1 }}</h2>
                        {% endunless %}
                        {% unless block.settings.subheading_1 == blank %}
                        <div class="subtitle">{{ block.settings.subheading_1 }}</div>
                        {% endunless %}
                    </div>
                        
                </div>
                <div class="col-wide-3">
                    <div class="icon">
                    {% if block.settings.icon_2 %}
                        {{ block.settings.icon_2 }}
                    {% else %}
                        {% if block.settings.image_2 %}
                            <picture>
                                <img src="{{ block.settings.image_2 | img_url: '1920x' }}" alt="" />
                            </picture>
                        {% else %}
                            <span class="placeholder-background">
                                {% capture current %}{% cycle 1, 2 %}{% endcapture %}
                                {{ 'lifestyle-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                            </span>
                        {% endif %}
                    {% endif %}   
                    </div> 
                    <div class="text-content">
                        {% unless block.settings.title_2 == blank %}
                        <h2 class="title">{{ block.settings.title_2 }}</h2>
                        {% endunless %}
                        {% unless block.settings.subheading_2 == blank %}
                        <div class="subtitle">{{ block.settings.subheading_2 }}</div>
                        {% endunless %}
                    </div>
                        
                </div>
                <div class="col-wide-3">
                    <div class="icon">
                    {% if block.settings.icon_3 %}
                        {{ block.settings.icon_3 }}
                    {% else %}
                        {% if block.settings.image_3 %}
                            <picture>
                                <img src="{{ block.settings.image_3 | img_url: '1920x' }}" alt="" />
                            </picture>
                        {% else %}
                            <span class="placeholder-background">
                                {% capture current %}{% cycle 1, 2 %}{% endcapture %}
                                {{ 'lifestyle-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                            </span>
                        {% endif %}
                    {% endif %}   
                    </div>                
                    <div class="text-content">
                        {% unless block.settings.title_3 == blank %}
                        <h2 class="title">{{ block.settings.title_3 }}</h2>
                        {% endunless %}
                        {% unless block.settings.subheading_3 == blank %}
                        <div class="subtitle">{{ block.settings.subheading_3 }}</div>
                        {% endunless %}
                    </div>
                       
                </div>
                <div class="col-wide-3">
                     <div class="icon">
                    {% if block.settings.icon_4 %}
                        {{ block.settings.icon_4 }}
                    {% else %}
                        {% if block.settings.image_4 %}
                            <picture>
                                <img src="{{ block.settings.image_4 | img_url: '1920x' }}" alt="" />
                            </picture>
                        {% else %}
                            <span class="placeholder-background">
                                {% capture current %}{% cycle 1, 2 %}{% endcapture %}
                                {{ 'lifestyle-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                            </span>
                        {% endif %}
                    {% endif %}  
                    </div> 
                    <div class="text-content">
                        {% unless block.settings.title_4 == blank %}
                        <h2 class="title">{{ block.settings.title_4 }}</h2>
                        {% endunless %}
                        {% unless block.settings.subheading_4 == blank %}
                        <div class="subtitle">{{ block.settings.subheading_4 }}</div>
                        {% endunless %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>