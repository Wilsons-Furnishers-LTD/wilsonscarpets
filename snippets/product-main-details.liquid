{% assign delivery_type = product.type | prepend: 'delivery-' | append: '-block' | handleize %}

<div class="product-main-details">
    <ul class="product-main-details__header">
        {% if product.description %}
            <li class="product-main-details__title active" data-item="description">
                Description
            </li>
        {% endif %}
        <li class="product-main-details__title" data-item="specs">
            Specs
        </li>
        {% if pages[delivery_type] %}
            <li class="product-main-details__title" data-item="delivery">
                Delivery
            </li>
        {% endif %}
    </ul>
    <div class="product-main-details__main">
        {% if product.description %}
            <div class="product-main-details__item">
                {{ product.description }}
            </div>
            <div class="product-features desktop">
                <div class="row"></div>
            </div>
        {% endif %}
        <div class="product-main-details__item">
            {% assign specifications = product.metafields.custom.specifications.value %}
            {% if section.blocks.size > 0 %}
                <div class="specifications">
                    {% if specifications %}
                        <ul>
                            {% for specification in specifications %}
                                <li><strong>{{ specification | replace: ':', '</strong>' }}</li>
                            {% endfor %}
                        </ul>
                    {% else %} 
                        <div class="content">
                            <ul>
                                
                                {% for block in section.blocks %}
                                    {% assign spec_tag = block.settings.tag | append: '_' %}
                                    
                                    {% for tag in product.tags %}
                                        {% if tag contains spec_tag and block.settings.tag %} 
                                            <li><strong>{{ block.settings.tag }}</strong> {{ tag | replace: spec_tag, '' }}</li>
                                        {% endif %} 
                                    {% endfor %}
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %} 
                </div>
            {% endif %}            
        </div>
        {% if pages[delivery_type] %}
            <div class="product-main-details__item">
                <div class="delivery">
                    <div class="content">
                        {{ pages[delivery_type].content }}
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</div>

<script type="text/javascript">
            var features_blocks = [],
                features_tags= [];

            {% for block in section.blocks %}
            	features_blocks.push({{ block.settings | json }});
        	{% endfor %}

	        {% for tag in product.tags %}
          	    {% if tag contains 'Feature_' %}
               	    {% assign feature = tag | replace: 'Feature_', '' %}
          		    features_tags.push({{ feature | json }});
                {% endif %}
          	{% endfor %}
    		jQuery.each(features_blocks, function(index, value) {
            	var tag_block = value,
                        image = tag_block.image,
                        title = tag_block.title,
                        subheading = tag_block.subheading,
                        link = tag_block.link,
                        feature_html = '';
                
                jQuery.each(features_tags, function(index, value) {
                    var tag_title = value;
	
                    if(tag_title == title){
                        feature_html += '<div class="feature">';
                        if(link != ''){
                            feature_html += '<a class="image" href="'+ link +'">';
                        }
                        if(image != ''){
                            feature_html += '<picture><img src="'+ image +'" alt="'+ title +'"/></picture>';
                        }
                        if(link != ''){
                            feature_html += '</a>';
                        }
                        feature_html += '<div class="text-content">'
                        if(title != ''){
                            feature_html += '<h2 class="title">'+ title +'</h2>';
                        }
                        if(subheading != ''){
                            feature_html += '<p class="subtitle">'+ subheading +'</p>';
                        }
                        feature_html += '</div>'
                        feature_html += '</div>';
                        jQuery('.product-features .row').append(feature_html);
                    }
                });
            });
        </script>