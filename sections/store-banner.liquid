{%- comment -%}
    Uses the same markup as sections/banner.liquid, so it picks up the theme's banner styles.
    Content comes from the current store_page metaobject (templates/metaobject/store_page.json), not section settings.
{%- endcomment -%}
{%- assign store = metaobject -%}
{%- assign store_name = store.store_finder_name.value | default: store.name.value -%}
{%- assign store_image = store.store_finder_thumbnail.value -%}
{%- assign store_url = store.system.url -%}
{%- if store_url == request.path -%}
    {%- assign store_url = blank -%}
{%- endif -%}
<div data-section-id="{{ section.id }}" data-section-type="store-banner" class="banner-one store-banner">
    <div class="row">
        <div class="col-wide-12 col-img text-light">
            {% if store_url != blank %}
                <a class="image" href="{{ store_url }}">
            {% endif %}
            {% if store_image != blank %}
                <picture>
                    <source media="(min-width: 1440px)" srcset="{{ store_image | image_url }}">
                    <source media="(min-width: 1390px)" srcset="{{ store_image | image_url: width: 1440 }}">
                    <source media="(min-width: 1340px)" srcset="{{ store_image | image_url: width: 1390 }}">
                    <source media="(min-width: 1280px)" srcset="{{ store_image | image_url: width: 1340 }}">
                    <source media="(min-width: 1024px)" srcset="{{ store_image | image_url: width: 1280 }}">
                    <source media="(min-width: 768px)" srcset="{{ store_image | image_url: width: 1024, height: 640, crop: 'center' }}">
                    <source media="(min-width: 540px)" srcset="{{ store_image | image_url: width: 640, height: 600, crop: 'center' }}">
                    <source srcset="{{ store_image | image_url: width: 540, height: 506, crop: 'center' }}">
                    <img width="1600" height="533" src="{{ store_image | image_url }}" alt="{{ store_image.alt | default: store_name | escape }}" />
                </picture>
            {% else %}
                <span class="placeholder-background">
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                </span>
            {% endif %}
            {% if store_url != blank %}
                </a>
            {% endif %}
            <div class="text-wrap overlay">
                <div class="wrapper">
                    <div class="text-content">
                        {% unless store_name == blank %}
                            <h2 class="title">{{ store_name | escape }}</h2>
                        {% endunless %}
                        {% unless store.address.value == blank %}
                            <p class="subtitle">{{ store.address.value | escape }}</p>
                        {% endunless %}
                        {% if store_url != blank %}
                            <a class="button" href="{{ store_url }}">Find out more</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% schema %}
    {
        "name": "Store Banner",
        "class": "index-section",
        "settings": [],
        "presets": [{
            "name": "Store Banner",
            "category": "Image"
        }]
    }
{% endschema %}
