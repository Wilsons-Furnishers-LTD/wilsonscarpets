  !!!! - PLEASE DO NOT EDIT - !!!!
  THIS FILE IS DEPLOYED AUTOMATICALLY BY GITHUB.
  CHANGES YOU MAKE MAY BE AUTOMATICALLY OVERWRITTEN AT ANY TIME.

  Github is used to create an automated theme deployment pipeline for Shopify,
  it is used to provide version control, theme testing and reliable deployment environments.

  If you need to modify this file, please contact Juno eCommerce at shopify@junowebdesign.com.
{%- endcomment -%}
{% assign afterText = "" %}
{% assign beforeText = "Only " %}
{% assign beforeText = "Only " %}
{% assign afterText = "" %}
{% comment %}
    check to see if it's a cloned product:
{% endcomment %}
{% assign productTag = '' %}
{% assign productPromo = '' %}
{% assign onSaleClass = '' %}
{% assign RRPPrice = '' %}
{% assign packSizePerSQM = 1 %}


{% for tag in product.tags %}
    {% if tag contains 'After Label_' %}
        {% assign afterText = tag | replace: 'After Label_', '' | prepend: " " %}
    {% endif %}
    {% if tag contains 'RRP_' %}
        {% assign RRPPrice = tag | replace: 'RRP_', '' | plus: 0 %}
    {% endif %}
    {% if tag contains 'Before Label_' %}
        {% assign beforeText = tag | replace: 'Before Label_', '' | prepend: "<small>" | append: "</small> " %}
    {% endif %}
{% endfor %}

{% if RRPPrice != '' %}
    {% assign priceSquareMetre = RRPPrice | times: 100 %}
    {% assign purchasePricePerSQM = product.price | divided_by: packSizePerSQM %}
{% endif %}

{% for tag in product.tags %}
    {% if tag contains 'parent_' %}
        {% assign parentHandle = tag | replace: 'parent_', '' %}
        <script>
            window.location = "/products/{{ parentHandle }}";
        </script>
    {% endif %}
    {% if tag contains 'RRP_' %}
        {% assign RRPPrice = tag | replace: 'RRP_', '' | plus: 0 %}
    {% endif %}
    {% if tag contains 'Pack Size (M²)_' %}
        {% assign packSizePerSQM = tag | replace: 'Pack Size (M²)_', '' | split: 'm' | first | plus: 0 %}
    {% endif %}
    {% if tag contains 'After Label_' %}
        {% assign afterText = tag | replace: 'After Label_', '' | prepend: " " %}
    {% endif %}
    {% if tag contains 'promo_' %}
        {% assign productPromo = tag | replace: 'promo_' %}
    {% endif %}
{% endfor %}

<div class="product-mobile-header">
    {% render 'breadcrumbs' %}
    <h1 itemprop="name">{{ product.title }}</h1>
    {% assign product_vendor_handle = product.vendor | handle %}
    {% comment %}
      Do we have a collection that has the same name as our product vendor name?
      If we do, let's have the vendor link point to it.
      If not, we will point to the automatic vendor collection.
    {% endcomment %}
    {% if collections[product_vendor_handle].handle == product_vendor_handle %}
      {% assign vendor_url = collections[product_vendor_handle].url %}
    {% else %}
      {% assign vendor_url = product.vendor | url_for_vendor %}
    {% endif %}

    {% assign getallSKUs = product.selected_or_first_available_variant.sku %}
    {% assign getallSKUs = getallSKUs | replace: "0", "" %}
    {% assign getallSKUs = getallSKUs | replace: "1", "" %}
    {% assign getallSKUs = getallSKUs | replace: "2", "" %}
    {% assign getallSKUs = getallSKUs | replace: "3", "" %}
    {% assign getallSKUs = getallSKUs | replace: "4", "" %}
    {% assign getallSKUs = getallSKUs | replace: "5", "" %}
    {% assign getallSKUs = getallSKUs | replace: "6", "" %}
    {% assign getallSKUs = getallSKUs | replace: "7", "" %}
    {% assign getallSKUs = getallSKUs | replace: "8", "" %}
    {% assign getallSKUs = getallSKUs | replace: "9", "" %}

    {% if ShoppingID != "" %}
      {% assign getallSKUs = ShoppingID %}
    {% else %}
      {% assign getallSKUs = getallSKUs | append: '*' %}
    {% endif %}

    {% assign stockAvailability = '' %}
    {% if product.variants.size > 1 %}
      {% assign stockAvailability = 'Out of stock' %}
      {% for variant in product.variants %}
        {% if variant.metafields.Juno.is_in_stock != '0' %}
          {% assign stockAvailability = 'In stock' %}
          {% break %}
        {% endif %}
      {% endfor %}
    {% else %}
      {% if product.metafields.Juno.is_in_stock != '0' %}
        {% if product.metafields.Juno.lowstock == 'Yes' %}
          {% assign stockAvailability = 'Order Now' %}
        {% else %}
          {% assign stockAvailability = 'In Stock' %}
        {% endif %}
      {% else %}
        {% assign stockAvailability = 'Out of stock' %}
      {% endif %}
    {% endif %}
    <div class="stock-delivery-wrapper">
    <p id="stockLevel" class="{{stockAvailability | handle | replace: '-', ''}} ">
      <i class="icon-{{stockAvailability | handle | replace: '-', ''}}"></i>
      {{ stockAvailability }}
    </p>


    <div class="price-only{{ onSaleClass }}">
      {% assign afterText = afterText | strip | downcase %}
      {% if product.type == 'Carpet' or product.type == 'Carpets' or product.type == 'Vinyl' or product.type == 'Artificial Grass' %}
        <h2>{{ beforeText }}{{ product.price | money }}{{ afterText }}</h2>
        {% if product.compare_at_price > product.price %}
          {% assign wasPrice = product.compare_at_price | money | prepend: 'was ' | append: afterText %}
        {% else %}
          {% assign wasPrice = RRPPrice | times: 100 | money | prepend: 'RRP ' | append: afterText %}
        {% endif %}
      {% elsif product.type == 'Laminate' or product.type == 'LVT' %}
        <h2>{{ beforeText }}{{ product.price | divided_by: packSizePerSQM | money }}{{ afterText }}</h2>

        {% if product.compare_at_price > product.price %}
          {% assign wasPrice = product.compare_at_price | divided_by: packSizePerSQM | money | prepend: 'was ' | append: afterText %}
        {% else %}
          {% assign wasPrice = RRPPrice | times: 100 | money | prepend: 'RRP ' | append: afterText %}
        {% endif %}
      {% else %}
        <h2>{{ beforeText }} <span class="update-on-change">{{ product.price | divided_by: packSizePerSQM | money }}</span>{{ afterText }}</h2>
        {% if product.compare_at_price > product.price %}
          {% assign wasPrice = product.compare_at_price | divided_by: packSizePerSQM | money | prepend: 'was ' | append: afterText %}
        {% else %}
          {% assign wasPrice = RRPPrice | times: 100 | money | prepend: 'RRP ' | append: afterText %}
        {% endif %}
      {% endif %}
      
      {% if priceSquareMetre > purchasePricePerSQM or product.compare_at_price > product.price %}
        <h3>
          <span>{{ wasPrice }}</span>
          {% assign percentSaved = priceSquareMetre | minus: purchasePricePerSQM | divided_by: priceSquareMetre | times: 100 | ceil %}
          {% if RRPPrice == '' and product.compare_at_price <= product.price %}
            {% if priceSquareMetre != product.price %}
              (Save
              {{ percentSaved }}%)
            {% endif %}
          {% endif %}
        </h3>
      {% endif %}
    </div>
    
</div>