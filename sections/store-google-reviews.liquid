{% render 'store-google-reviews-content', store: metaobject, section_id: section.id, heading: section.settings.heading, max_reviews: section.settings.max_reviews, min_rating: section.settings.min_rating %}

{% schema %}
    {
        "name": "Store Google Reviews",
        "class": "index-section",
        "settings": [
            {
                "type": "text",
                "id": "heading",
                "label": "Heading",
                "default": "Google Reviews"
            },
            {
                "type": "range",
                "id": "max_reviews",
                "label": "Number of reviews",
                "info": "Google returns up to 5 reviews.",
                "min": 1,
                "max": 5,
                "step": 1,
                "default": 5
            },
            {
                "type": "range",
                "id": "min_rating",
                "label": "Only show reviews rated at least",
                "min": 1,
                "max": 5,
                "step": 1,
                "default": 4
            }
        ],
        "presets": [{
            "name": "Store Google Reviews",
            "category": "Text"
        }]
    }
{% endschema %}
