{% render 'store-map-content', store: metaobject, section_id: section.id, zoom: section.settings.zoom, height: section.settings.height %}

{% schema %}
    {
        "name": "Store Map",
        "class": "index-section",
        "settings": [
            {
                "type": "range",
                "id": "zoom",
                "label": "Zoom",
                "min": 10,
                "max": 18,
                "step": 1,
                "default": 15
            },
            {
                "type": "range",
                "id": "height",
                "label": "Map height (desktop)",
                "min": 250,
                "max": 700,
                "step": 50,
                "unit": "px",
                "default": 450
            }
        ],
        "presets": [{
            "name": "Store Map",
            "category": "Image"
        }]
    }
{% endschema %}
