{% assign delivery_type = product.type | prepend: 'delivery-' | append: '-block' | handleize %}

<div class="product-main-details">
    <ul class="product-main-details__header">
        {% if product.description %}
            <li class="product-main-details__title active" data-item="description">
                Description
            </li>
        {% endif %}
        <li class="product-main-details__title" data-item="specs">
            Specs
        </li>
        {% if pages[delivery_type] %}
            <li class="product-main-details__title" data-item="delivery">
                Delivery
            </li>
        {% endif %}
    </ul>
    <div class="product-main-details__main">
        {% if product.description %}
            <div class="product-main-details__item active" id="tab-description">
                {{ product.description }}
                <div class="product-features">
                {% for tag in product.tags %}
                {% if tag contains 'Feature_' %}
                    {% assign feature_title = tag | remove: 'Feature_' %}

                    {% for block in section.blocks %}
                    {% if block.settings.title == feature_title %}
                        <div class="feature" {{ block.shopify_attributes }}>

                        {% if block.settings.link != blank %}
                            <a class="image" href="{{ block.settings.link }}">
                        {% endif %}

                        {% if block.settings.image != blank %}
                            <picture>
                            <img
                                src="{{ block.settings.image | image_url }}"
                                alt="{{ block.settings.title | escape }}"
                                loading="lazy"
                            >
                            </picture>
                        {% endif %}

                        {% if block.settings.link != blank %}
                            </a>
                        {% endif %}

                        <div class="text-content">
                            {% if block.settings.title != blank %}
                            <h2 class="title">{{ block.settings.title }}</h2>
                            {% endif %}

                            {% if block.settings.subheading != blank %}
                            <p class="subtitle">{{ block.settings.subheading }}</p>
                            {% endif %}
                        </div>

                        </div>
                    {% endif %}
                    {% endfor %}
                {% endif %}
                {% endfor %}
            </div>
            </div>
        {% endif %}
        <div class="product-main-details__item" id="tab-specs">
            {% assign specifications = product.metafields.custom.specifications.value %}
            {% if section.blocks.size > 0 %}
                <div class="specifications">
                    {% if specifications %}
                        <ul>
                            {% for specification in specifications %}
                                <li><strong>{{ specification | replace: ':', '</strong>' }}</li>
                            {% endfor %}
                        </ul>
                    {% else %} 
                        <div class="content">
                            <ul>
                                
                                {% for block in section.blocks %}
                                    {% assign spec_tag = block.settings.tag | append: '_' %}
                                    
                                    {% for tag in product.tags %}
                                        {% if tag contains spec_tag and block.settings.tag %} 
                                            <li><strong>{{ block.settings.tag }}</strong> {{ tag | replace: spec_tag, '' }}</li>
                                        {% endif %} 
                                    {% endfor %}
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %} 
                </div>
            {% endif %}            
        </div>
        {% if pages[delivery_type] %}
            <div class="product-main-details__item" id="tab-delivery">
                <div class="delivery">
                    <div class="content">
                        {{ pages[delivery_type].content }}
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</div>


