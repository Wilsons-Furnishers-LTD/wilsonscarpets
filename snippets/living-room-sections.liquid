<div id="section-{{ section.id }}" class="cms-sections">
  {% for block in section.blocks %}
    <div class="item" {{ block.shopify_attributes }}>

      {% case block.type %}

        {% when 'banner' %}
          {% render 'bedroom_banner', block: block %}

        {% when 'bannertwo' %}
          {% render 'bedroom_bannergrid-two', block: block %}

        {% when 'bannerthree' %}
          {% render 'bedroom_bannergrid-three', block: block %}

        {% when 'bannerfour' %}
          {% render 'bedroom_bannergrid-four', block: block %}

        {% when 'onecol-txt' %}
          {% render 'bedroom_onecol-txt', block: block %}

        {% when 'onecol-txt-img' %}
          {% render 'bedroom_onecol-txt-img', block: block %}

        {% when 'twocol-txt' %}
          {% render 'bedroom_twocol-txt', block: block %}

        {% when 'twocol-1-img-txt' %}
          {% render 'bedroom_twocol-1-img-txt', block: block %}

        {% when 'featured-collection' %}
          {% render 'bedroom_featuredcollection', block: block %}

        {% when 'bedroom-button-findout' %}
          {% render 'bedroom-button', block: block %}

      {% endcase %}

    </div>
  {% endfor %}
</div>