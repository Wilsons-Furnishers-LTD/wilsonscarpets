            async function httpRequest(url, data, type) {
                return new Promise(function (resolve, reject) {
                    let http_request = typeof XMLHttpRequest != 'undefined' ? new XMLHttpRequest() : new ActiveXObject('Microsoft.XMLHTTP');

                    http_request.onreadystatechange = function () {
                        let status;
                        if (http_request.readyState == 4) {
                            status = http_request.status;
                            if (status == 200) {
                                try {
                                    resolve(http_request.responseText);
                                } catch (e) {
                                    reject(xhr.status)
                                }
                            }
                        }
                    };
                    http_request.ontimeout = function () {
                        reject('timeout');
                    };
                    http_request.open(type, url, true);
                    http_request.withCredentials = true;
                    http_request.setRequestHeader('Content-Type', 'application/json');
                    http_request.send(JSON.stringify(data));
