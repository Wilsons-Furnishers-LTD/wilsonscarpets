	<script type="text/javascript" defer="defer">
	function storeifyOpentab(t,ele) {
	  // var element = document.getElementById("myDIV");
	    var ele_1 =  document.getElementsByClassName("map-tab-mobile-bnt-item");
	    var ele_2 = document.getElementsByClassName("map-tab-mobile");
	    for (var i = 0; i < ele_1.length; i++) {
		   ele_1[i].classList.remove('active');
		   ele_2[i].classList.remove('active');
		}
	  t.classList.add('active');
	  document.getElementsByClassName(ele)[0].classList.add("active");
	  // $('.'+$(this).data('val')).addClass('active');
	}
	</script>
	

            
