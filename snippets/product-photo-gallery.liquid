{% assign productPromo = '' %}
{% assign productTag = '' %}

{% if product.compare_at_price > product.price %}
    {% assign onSaleClass = ' sale' %}
    {% assign beforeText = '<small>Now</small> ' %}
    {% comment %}
    {% assign productTag = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price | append: '%<br>OFF' | prepend: '<span>Up to</span>' %}
    {% endcomment %}
    {% assign productTag = 'Sale<br>Price' %}
{% endif %}

{% for tag in product.tags %}
    {% if tag contains 'promo_' %}
        {% assign productPromo = tag | replace: 'promo_' %}
    {% endif %}
{% endfor %}

{% for product_option in product.options_with_values %}
    {% assign product_option_name = product_option.name | downcase %}
    {% assign position = product_option.position | minus: 1 %}
    {% if product_option_name == 'color' or product_option_name == 'colour' %}
        {% assign value_colors = '' %}
        {% assign position_option_colors = position %}
        {% for variant in product.variants %}
            {% assign value = variant.title | split: ' / ' %}
            {% assign value = value[position] | lstrip %}
            {% assign value_colors = value_colors | append: value %}
            {% if forloop.last == false %}
                {% assign value_colors = value_colors | append: ' / ' %}
            {% endif %}
        {% endfor %}
        {% assign value_colors = value_colors | split: ' / ' | uniq %}
    {% endif %}
    {% if product_option_name == 'width' or product_option_name == 'rug size' %}
        {% assign value_sizes = '' %}
        {% assign length_value_sizes = '' %}
        {% assign position_option_size = position %}
        {% for variant in product.variants %}
            {% assign value = variant.title | split: ' / ' %}
            {% assign value = value[position] | lstrip %}
            {% assign value_sizes = value_sizes | append: value %}
            {% if variant.metafields.juno.is_in_stock == "1" %}
                {% assign length_value_sizes = length_value_sizes | append: value %}
            {% endif %}
            {% if forloop.last == false %}
                {% if variant.metafields.juno.is_in_stock == "1" %}
                    {% assign length_value_sizes = length_value_sizes | append: ' / ' %}
                {% endif %}
                {% assign value_sizes = value_sizes | append: ' / ' %}
            {% endif %}
        {% endfor %}
        {% assign value_sizes = value_sizes | split: ' / ' | uniq %}
    {% endif %}
{% endfor %}



<div class="product-photo-gallery-container">
    <ul class="iconsFlag">
        {% for tag in product.tags %}
            {% if tag contains 'flag_' or tag contains 'Flag_' %}
                <li><img src="{{ tag | capitalize | file_img_url: 'master' }}" alt=""/></li>
            {% endif %}
        {% endfor %}
    </ul>
    <div class="tag-prod-wrap">
        {% if productPromo != '' %}
            <span class="productTag">{{ productPromo }}</span>
        {% endif %}
        {% if productTag != '' and productPromo == '' %}
            <span class="productTag">{{ productTag }}</span>
        {% endif %}
    </div>

    {% assign usedPhotoUI = false %}
    {% for tag in product.tags %}
        {%- assign tag_downcase = tag | downcase -%}
        {% if tag_downcase contains 'photoui' %}
            {% assign usedPhotoUI = true %}
        {% endif %}
    {% endfor %}

    {% if product.has_only_default_variant or product.variants.size == 1 or usedPhotoUI == false %}
        {% assign image_exclude = "" %}
        {% capture variant_images %}
            {% for value_color in value_colors %}
                {% assign color = value_color | strip %}
                {% assign displayedColor = '' %}
                {% assign firstDisplayed = true %}
                {% for variant in product.variants %}


                        {% for option in variant.options %}
                            {% if option == color %}
                                {% unless displayedColor contains color %}
                                    {% assign displayedColor = displayedColor | append: '|' | append: color %}
                                        <div class="item {{ variant.title }}" data-value="{{ color }}">
                                            <a class="featherlight-gallery" href="{{ variant.image | img_url: '1600x1600' }}">
                                                <picture>
                                                    <source media="(min-width: 1024px)" srcset="{{ variant.image | img_url: '1600x1600' }}">
                                                    <source srcset="{{ variant.image | img_url: '860x860' }}">
                                                    <img class="product-photo-image" src="{{ variant.image | img_url: '1600x1600' }}" alt="{{ color }}"/>
                                                </picture>
                                            </a>
                                            <span class="zoom-mobile"><img src="{{ variant.image | img_url: '1600x1600' }}" alt="" /></span>
                                        {% assign image_exclude = image_exclude | append: variant.image.src | append: "<|>" %}
                                    {% break %}
                                {% endunless %}
                            {% endif %}
                        {% endfor %}

                        {% assign firstDisplayed = false %}

                {% endfor %}
                </div>
            {% endfor %}
        {% endcapture %}

        {% assign image_exclude = image_exclude | replace: "products/", "" %}

        {% capture product_images %}
        {% assign firstDisplayed = true %}
        {% for image in product.images %}
            {% assign variant_image = image | replace: "products/", "" %}
            {% unless image_exclude contains variant_image %}
                {% if product_option_name == 'color' or product_option_name == 'colour' or product_option_name == 'quantity' or product_option_name == 'width' or product_option_name == 'rug size' %}
                    {% unless image.attached_to_variant? %}
                        <div class="item">
                            <a class="featherlight-gallery" href="{{ image | img_url: '1600x1600' }}">
                                <picture>
                                    <source media="(min-width: 1024px)" srcset="{{ image | img_url: '1600x1600' }}">
                                    <source srcset="{{ image | img_url: '1600x1600' }}">
                                    <img src="{{ image | img_url: '1600x1600' }}" alt="{{ product.title | escape }}"/>
                                </picture>
                            </a>
                            <span class="zoom-mobile"><img src="{{ image | img_url: '1600x1600' }}" alt="" /></span>
                        </div>
                    {% endunless %}
                {% else %}
                    <div class="item">
                        <a class="featherlight-gallery" href="{{ image | img_url: '1600x1600' }}">
                            <picture>
                            <source media="(min-width: 1024px)" srcset="{{ image | img_url: '1600x1600' }}">
                                <source srcset="{{ image | img_url: '1600x1600' }}">
                                <img src="{{ image | img_url: '1600x1600' }}" alt="{{ product.title | escape }}"/>
                            </picture>
                        </a>
                        <span class="zoom-mobile"><img src="{{ image | img_url: '1600x1600' }}" alt="" /></span>
                    </div>
                    {% assign image_exclude = image_exclude | append: image.src | append: "<|>" %}
                {% endif %}
                {% assign firstDisplayed = false %}
            {% endunless %}
        {% endfor %}
        {% endcapture %}

        <div class="product-photo-gallery" data-photoui="{{ usedPhotoUI | json }}">
            <div class="product-photo-gallery__colour" id="product-colour-text"></div>
            <div class="owl-carousel">
                {{product_images}}
                {{variant_images}}
            </div>
        </div>


        {% if product.images.size > 1 %}
            {% assign image_exclude = "" %}
            <div class="wc-product-photo-thumbs">
                <div class="product-photo-thumbs-container swiper">
                    <ul class="product-photo-thumbs swiper-wrapper">
                        {% capture variant_images %}
                            {% for value_color in value_colors %}
                                {% assign color = value_color | strip %}
                                {% assign displayedColor = '' %}
                                {% for variant in product.variants %}
                                        {% for option in variant.options %}
                                            {% if option == color %}
                                                {% unless displayedColor contains color %}
                                                    {% assign displayedColor = displayedColor | append: '|' | append: color %}
                                                        <li class="swiper-slide product-photo-thumb js-product-photo-thumb two-per-row" data-value="{{ color }}">
                                                            <a href="#" class="data" data-quantity="{{ variant.inventory_quantity }}" data-stockLevel="{{ variant.metafields.Juno.lowstock }}" data-deliveryEstimate="{{ variant.metafields.Juno.Delivery_time }}"><img src="{{ variant.image.src | img_url: '80x80', crop: 'center' }}" alt="{{ variant.image.alt | escape }}"/></a>
                                                        {% assign image_exclude = image_exclude | append: variant.image.src | append: "<|>" %}
                                                    {% break %}
                                                {% endunless %}
                                            {% endif %}
                                        {% endfor %}

                                {% endfor %}
                                </li>
                            {% endfor %}
                        {% endcapture %}

                        {% assign image_exclude = image_exclude | replace: "products/", "" %}


                        {% capture product_images %}
                        {% for image in product.images %}
                            {% assign variant_image = image | replace: "products/", "" %}
                            {% unless image_exclude contains variant_image %}
                                {% if product_option_name == 'color' or product_option_name == 'colour' or product_option_name == 'quantity' or product_option_name == 'width' or product_option_name == 'rug size' %}
                                    {% unless image.attached_to_variant? %}
                                        <li class="swiper-slide product-photo-thumb js-product-photo-thumb two-per-row {{product_option_name}}" data-value="">
                                            <a href="#" class="data" data-quantity="{% if product.available %}999{% endif %}" data-stockLevel="{{ product.metafields.Juno.lowstock }}" data-deliveryEstimate="{{ product.metafields.customAttributes.delivery-time }}"><img src="{{ image | img_url: '80x80', crop: 'center' }}" alt="{{ image.alt | escape }}"  /></a>
                                        </li>

                                    {% endunless %}
                                {% else %}
                                    <li class="swiper-slide product-photo-thumb js-product-photo-thumb two-per-row {{product_option_name}}" data-value="">
                                        <a href="#" class="data" data-quantity="{% if product.available %}999{% endif %}" data-stockLevel="{{ product.metafields.Juno.lowstock }}" data-deliveryEstimate="{{ product.metafields.customAttributes.delivery-time }}"><img src="{{ image | img_url: '80x80', crop: 'center' }}" alt="{{ image.alt | escape }}"  /></a>
                                    </li>
                                    {% assign image_exclude = image_exclude | append: image.src | append: "<|>" %}
                                {% endif %}
                            {% endunless %}
                        {% endfor %}
                        {% endcapture %}

                        {{product_images}}
                        {{variant_images}}
                    </ul>
                </div>
                <div class="swiper-button-prev">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="45" fill="none"  stroke-width="6"/><path d="m58 30-20 20 20 20" fill="none" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
                <div class="swiper-button-next">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="45" fill="none"  stroke-width="6"/><path d="m42 30 20 20-20 20" fill="none" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
            </div>
        {% endif %}
    {% else %}
        <div class="product-photo-container" data-photoui="{{ usedPhotoUI | json }}" data-large="{{ product.featured_image | img_url: '860x860' }}">
            <div class="owl-carousel">
                <div class="item">
                    <a class="featherlight-gallery" href="{{ product.featured_image | img_url: '860x860' }}">
                        <picture class="product-photo-container__frame">
                            <source media="(min-width: 1024px)" srcset="{{ product.featured_image  | img_url: '600x600' }} 1x, {{ product.featured_image | img_url: '600x600',scale: 2 }} 2x">
                            <source srcset="{{ product.featured_image | img_url: '860x860' }} 1x, {{ product.featured_image | img_url: '860x860',scale:2 }} 2x">
                            <img class="product-photo-container__img" src="{{ product.featured_image | img_url: '600x600' }}" alt="{{ product.title | escape }}" />
                        </picture>
                    </a>
                    <span class="zoom-mobile"><img src="{{ product.featured_image | img_url: '860x860' }}" alt="" /></span>
                </div>
            </div>
        </div>

        <div class="product-photo-thumbs-holder"></div>
    {% endif %}



</div>

<script>
    jQuery(document).ready(function () {
        const loop = false;
        const is_loop = loop ?? true;
        jQuery(".product-photo-gallery .owl-carousel").owlCarousel({
            items: 1,
            loop: is_loop,
            margin: 0,
            nav: true,
            dots: true,
            animateOut: '',
            mouseDrag: false,
            touchDrag: true,
            lazyLoad: true,
            responsive: {
                0: {
                    loop: true,
                    mouseDrag: true,
                    margin: 15,
                },
                480: {
                    loop: true,
                    mouseDrag: true,
                    margin: 20,
                },
                1024: {
                    mouseDrag: true
                }
            },
            onInitialized: function(){


                jQuery('.product-photo-gallery .featherlight-gallery').zoom({
                    magnify: 1.35,
                    callback: function(){

                    }
                });

                /* mobile swipe initial on top zoom element */
                // var zoomElement = document.querySelector('.product-photo-gallery .owl-item.active span.zoom-mobile');
                // let pz = new PinchZoom.default(zoomElement, {draggableUnzoomed: false});///(zoomElement);
                // pz.enable(); // Enables all gesture capturing (is enabled by default)

                var hammertime = new Hammer(zoomElement, {});
                hammertime.on('swipeleft swiperight', function(ev) {

                    if(ev.type === 'swipeleft'){
                        //jQuery('.option-colour .swatch-colours li:first-child').trigger('click');
                        //jQuery('.option-colour .swatch-colours li.selected').next().trigger('click')
                        jQuery('.product-photo-thumb').eq(currentItem - 1).trigger('click');
                    }

                    if(ev.type === 'swiperight'){
                        //jQuery('.product-photo-gallery .owl-dot.active').next().trigger('click');
                        jQuery('.product-photo-thumb').eq(currentItem + 1).trigger('click');

                    }
                });
            }
        });
        jQuery(".product-photo-gallery .owl-carousel").on('changed.owl.carousel', function(event) {
            //var currentItem = event.item.index;
            const currentItem = jQuery('.product-photo-gallery .owl-dot.active').index();

            setTimeout(function() {
                jQuery('.product-photo-gallery .owl-stage .owl-item').removeClass('animated owl-animated-out fadeOut').css('left', '');
                var zoomElement = document.querySelector('.product-photo-gallery .owl-item.active span.zoom-mobile');
                let pz = new PinchZoom.default(zoomElement, {draggableUnzoomed: false});///(zoomElement);
                pz.enable(); // Enables all gesture capturing (is enabled by default)
            }, 100);

            //jQuery('.product-photo-thumbs a').removeClass('active');
            //jQuery('.product-photo-thumb').eq(currentItem).find('a').addClass('active');
            jQuery('.product-photo-thumb').eq(currentItem).trigger('click');

            var colour_variant = jQuery('.product-photo-thumb').eq(currentItem).data('value');
            
            if(colour_variant != '') {
              jQuery('#select-option-colour ul').each(function () {
                    jQuery(this).find('li[data-value="' + colour_variant + '"]').trigger('click');
                });
            }
        })

        jQuery('.product-photo-thumbs li').click(function (e) {
            e.preventDefault();
            var index = jQuery(this).index(),
                value = jQuery(this).data('value'),
                swatch = jQuery('.swatch-colours'),
                ul = swatch.find('ul');
                colour = swatch.find('.select li[data-value="' + value + '"]').html();

            if (value && value != '') {
                swatch.find('label').html(colour);
                swatch.find('li').removeClass('selected');
                swatch.find('.select ul').slideUp(200);
                jQuery(ul).each(function () {
                    jQuery(this).find('li[data-value="' + value + '"]').addClass('selected');
                });

                //swatchClick(value);
            }

            console.log()
            jQuery('.product-photo-thumbs a').removeClass('active');
            jQuery(this).find('a').addClass('active');
            jQuery('.owl-dots .owl-dot:nth-child(' + (index + 1) + ')').trigger('click');
        });

        if(is_loop){
            jQuery('.product-photo-gallery .featherlight-gallery').featherlightGallery({
                variant: "featherlight-product-photo-image",
                afterContent: function(){
                    var caption = this.$currentTarget.find('img').attr('alt');
                    this.$instance.find('.caption').remove();
                    this.$instance.addClass('loaded');
                    if(caption !== ''){
                        $('<div class="caption">').html('<span>' + caption + '</span>').appendTo(this.$instance.find('.featherlight-content'));
                    }
                }
            });
        }else{
            jQuery('.product-photo-gallery .featherlight-gallery').featherlight({
                variant: "featherlight-product-photo-image",
                afterContent: function(){
                    var caption = this.$currentTarget.find('img').attr('alt');
                    this.$instance.find('.caption').remove();
                    this.$instance.addClass('loaded');
                    if(caption !== ''){
                        $('<div class="caption">').html('<span>' + caption + '</span>').appendTo(this.$instance.find('.featherlight-content'));
                    }
                }
            });
        }
        
    })
</script>