                                    <a href="#" id="orderFreeSample" data-variant="{{ freeSampleProduct.selected_or_first_available_variant.id }}" data-defaultvariant="{{ freeSampleProduct.selected_or_first_available_variant.id }}" class="btn button button-second">Order FREE Sample</a>
                                {% endif %}

                            {% endif %}

