                                            <div class="selectWrapper">
                                                <select>
                                                    {% for value_size in value_sizes %}
                                                        {% assign metres = value_size | plus: 0 %}

                                                        {% assign feet = metres | times: 3.2808 | floor %}
                                                        {% assign inchesAccountedFor = feet | times: 12 %}
                                                        {% assign inches = metres | times: 39.370 | minus: inchesAccountedFor | floor %}


                                                        <option value="{{ value_size }}">{{ feet }}
                                                            ft
                                                            {{ inches }}
                                                            inches</option>
                                                    {% endfor %}
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}
                            </div>
