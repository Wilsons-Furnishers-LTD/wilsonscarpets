{{ 'storepages.css' | asset_url | stylesheet_tag }}
{{ 'stores-slider.js' | asset_url | script_tag }}
<div class="two-col-wb {% if page.id == 113656103219 %}search-page{% else %}cms-two-columns{% endif %}">
  <div class="wrapper">
    <div class="row">
      {% unless page.id == 113656103219 %}
        <div class="col-left">
            
            {% for block in section.blocks %}

                {% case block.type %}
                    {% when 'cms_page_left' %}
                        {% render 'cms-page-left', block: block %}
                {% endcase %}
            {% endfor %}
        </div>
      {% endunless %}

      <div class="col-main ">
        <div class="container">
          <div class="page-title">
            <h1>{{ page.title }}</h1>
          </div>

          <div class="cms-content">
            {{ page.content }}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% render 'gtm-page' %}

{% schema %}
{
  "name": "Main page",
  "blocks": [
    {
      "type": "cms_page_left",
      "name": "CMS Page Left",
      "settings": [
		{
			"type": "text",
			"id": "cms_heading",
			"label": "CMS Heading",
			"default": "Information Pages"
		},
		{
			"type": "link_list",
			"id": "cms_linklist",
			"label": "Cms Link 1"
		},
		{
			"type": "link_list",
			"id": "cms_linklist_two",
			"label": "Cms Link 2"
		},
		{
			"type": "link_list",
			"id": "cms_linklist_three",
			"label": "Cms Link 3"
		}
    ]
    }
  ]
}
{% endschema %}