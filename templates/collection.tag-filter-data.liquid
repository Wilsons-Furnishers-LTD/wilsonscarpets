{%- layout none -%}
{%- comment -%}
  Data for the asynchronous collection tag filters (src/scripts/tag-filters.js), requested as
  /collections/<handle>/<tag-a>+<tag-b>?view=tag-filter-data&sort_by=...&page=N

  Used when a filter group has more than one tag selected (e.g. Grey OR Beige): Shopify tag URLs
  only AND tags together, so the script fetches one URL per tag combination and merges the results.
  The data-* values let it de-duplicate and re-sort the merged list. 50 is the most a for loop returns per page.
{%- endcomment -%}
{%- paginate collection.products by 50 -%}
<div data-tag-filter-results data-pages="{{ paginate.pages }}">
  {%- for product in collection.products -%}
    <div
      data-tag-filter-product
      data-handle="{{ product.handle }}"
      data-price="{{ product.price_min }}"
      data-title="{{ product.title | escape }}"
      data-created="{{ product.created_at | date: '%s' }}"
    >
      {%- render 'product-grid-item', product: product -%}
    </div>
  {%- endfor -%}
</div>
{%- endpaginate -%}
