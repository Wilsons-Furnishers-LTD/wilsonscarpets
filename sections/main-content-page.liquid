{% assign show_col = true %}
{% if request.path == '/pages/search-results' %}
    {% assign show_col = false %}
    {{ 'filters.css' | asset_url | stylesheet_tag }}
{% endif %}
{% if show_col %}
    <style>
        .cms-two-columns  .col-main .container {
            max-width: 100%;
            width: 100%;
        }
    </style>
{% endif %}
<div class="{% if request.path == '/pages/search-results' %}search-page{% endif %} {% if show_col %}cms-two-columns{% endif %}">
  <div class="wrapper">
    <div class="row">
      {% if show_col %}
        <div class="col-left">
            
            {% for block in section.blocks %}

                {% case block.type %}
                    {% when 'cms_page_left' %}
                        {% render 'cms-page-left', block: block %}
                {% endcase %}
            {% endfor %}
        </div>
      {% endif %}

      <div class="col-main">
        <div class="container">
          <div class="page-title">
            <h1>{{ page.title }}</h1>
          </div>

          <div class="cms-content">
            {{ page.content }}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% render 'gtm-page' %}

{% schema %}
{
  "name": "Main page",
  "blocks": [
    {
      "type": "cms_page_left",
      "name": "CMS Page Left",
      "settings": [
		{
			"type": "text",
			"id": "cms_heading",
			"label": "CMS Heading",
			"default": "Information Pages"
		},
		{
			"type": "link_list",
			"id": "cms_linklist",
			"label": "Cms Link 1"
		},
		{
			"type": "link_list",
			"id": "cms_linklist_two",
			"label": "Cms Link 2"
		},
		{
			"type": "link_list",
			"id": "cms_linklist_three",
			"label": "Cms Link 3"
		}
    ]
    }
  ]
}
{% endschema %}