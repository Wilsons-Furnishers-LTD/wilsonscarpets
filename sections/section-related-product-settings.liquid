{% if section.settings.enable_cookies %}
<div class="section-cookie-popup" style="--bg-color: {{ section.settings.bg_color }};">
    <div class="wrapper">
        <div class="section-cookie-popup__inner">
            <div class="section-cookie-popup__wrapper">
                {% if section.settings.title != blank %}
                    <h3 class="section-cookie-popup__title" style="--title-color: {{ section.settings.title_color }};">{{ section.settings.title }}</h3>
                {% endif %}

                {% if section.settings.content != blank %}
                    <div class="section-cookie-popup__content" style="--content-color: {{ section.settings.content_color }};--link-color: {{ section.settings.button_bg_color }};">
                        {{ section.settings.content | replace: '<a>', '<a class="section-cookie-popup__content-link">' }}
                    </div>
                {% endif %}
            </div>

            {% if section.settings.button_text != blank %}
                <a href="#" class="section-cookie-popup__btn" style="--bg-color: {{ section.settings.button_bg_color }}">
                    {{ section.settings.button_text }}
                </a>
            {% endif %}
        </div>
    </div>
</div>

<script>
    $(document).on('ready', function() {
        const hide_popup = getCookie('hide_popup') == 'true'? true : false;
        if (hide_popup) {
            $('.section-cookie-popup').removeClass('is-active');
        } else {
            $('.section-cookie-popup').addClass('is-active');
        }

        $(document).on('click', '.section-cookie-popup__btn', function(e) {
            setCookie("hide_popup", "true", 365);
            $('.section-cookie-popup').removeClass('is-active');
            e.preventDefault();
        });
    });

    function setCookie(name,value,exdays) {
        var exdate = new Date();
        exdate.setDate(exdate.getDate() + exdays);
        document.cookie = name + "=" + (value || "") + ';expires=' + exdate.toGMTString() + ';path=/';
    }

    function getCookie(name) {
        var nameEQ = name + "=";
        var ca = document.cookie.split(';');
        for(var i=0;i < ca.length;i++) {
            var c = ca[i];
            while (c.charAt(0)==' ') c = c.substring(1,c.length);
            if (c.indexOf(nameEQ) == 0) return c.substring(nameEQ.length,c.length);
        }
        return null;
    }
</script>
{% endif %}

{% schema %}
{
    "name": "Related Product Settings",
    "settings": [
        {
            "type": "checkbox",
            "id": "enable_cookies",
            "label": "Enable cookies",
            "default": true
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Background Color",
            "default": "#1f325d"
        },
        {
            "type": "header",
            "content": "Content Settings"
        },
        {
            "type": "text",
            "id": "title",
            "label": "Title"
        },
        {
            "type": "color",
            "id": "title_color",
            "label": "Title Color",
            "default": "#feca52"
        },
        {
            "type": "richtext",
            "id": "content",
            "label": "Content"
        },
        {
            "type": "color",
            "id": "content_color",
            "label": "Content Color",
            "default": "#fff"
        },
        {
            "type": "header",
            "content": "Button"
        },
        {
            "type": "url",
            "id": "button_link",
            "label": "Button Link"
        },
        {
            "type": "text",
            "id": "button_text",
            "label": "Button Text"
        },
        {
            "type": "color",
            "id": "button_bg_color",
            "label": "Button Background Color",
            "default": "#feca52"
        }
    ]
}
{% endschema %}