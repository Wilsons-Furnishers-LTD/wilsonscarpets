                                                    {% assign numberOfSamplesInCart = numberOfSamplesInCart | plus: item.quantity %}
                                                    sampleVariantsAlreadyInCart.push("{{ item.variant_id }}");{% endif %}
                                            {% endfor %}
                                        {% endif %}
