{% comment %}
  A loop to catch and filter out the different tag categories.
  This is mainly for advanced tagging, but will also help us strip
  out any tag categories from our tags (E.g. remove BRAND_ from BRAND_tag)
{% endcomment %}
{% if collection.all_tags.size > 0 %}
  {% assign categories = '' %}
  {% assign colourCategory = '' %}

  {% for tag in collection.all_tags %}
    {% if tag contains 'Filter-Colour_' %}
      {% capture colourCategory %}{% unless colourCategory == blank  %}{{ colourCategory }}|{% endunless %}Filter-Colour{% endcapture %}
    {% endif %}
    {% if tag contains 'Backing_' %}
      {% capture categories %}{% unless categories == blank  %}{{ categories }}|{% endunless %}Backing{% endcapture %}
    {% endif %}
     {% if tag contains 'Style_' %}
      {% capture categories %}{% unless categories == blank  %}{{ categories }}|{% endunless %}Style{% endcapture %}
    {% endif %}
    {% if tag contains 'FilterLength_' %}
      {% capture categories %}{% unless categories == blank  %}{{ categories }}|{% endunless %}FilterLength{% endcapture %}
    {% endif %}
    {% if tag contains 'Width_' %}
      {% capture categories %}{% unless categories == blank  %}{{ categories }}|{% endunless %}Width{% endcapture %}
    {% endif %}
     {% if tag contains 'Shade_' %}
      {% capture categories %}{% unless categories == blank  %}{{ categories }}|{% endunless %}Shade{% endcapture %}
    {% endif %}
    {% if tag contains 'Thick_Filter_' %}
      {% capture categories %}{% unless categories == blank  %}{{ categories }}|{% endunless %}Thick_Filter{% endcapture %}
    {% endif %}
    {% if tag contains 'Manufacturer_' %}
      {% capture categories %}{% unless categories == blank  %}{{ categories }}|{% endunless %}Manufacturer{% endcapture %}
    {% endif %}
    {% if tag contains 'Material_' %}
      {% capture categories %}{% unless categories == blank  %}{{ categories }}|{% endunless %}Material{% endcapture %}
    {% endif %}


  {% endfor %}

  {% unless colourCategory == ''  %}
    {% unless categories == blank  %}
      {% assign categories = colourCategory | append: '|' | append: categories %}
    {% else %}
      {% assign categories = colourCategory %}
    {% endunless %}
  {% endunless %}


  {% assign cat_array = categories | split: '|' | uniq %}
  {% assign cat_order = 'Filter-Colour|Material|FilterLength|Width|Style|Backing|Manufacturer|Thick_Filter' | downcase%}
  {% assign cat_order_array = cat_order | split: '|' %}


  {% assign cat_new_order = '' %}


  {% for temp1 in cat_order_array  %}
    {% for temp2 in cat_array %}
      {% assign temp2_downcase = temp2 | downcase  %}
      {% if temp1 == temp2_downcase  %}
        {% assign cat_new_order = cat_new_order | append: temp2 | append: '|' %}
      {% endif%}
    {% endfor %}
  {% endfor %}


  {% assign cat_array = cat_new_order | split: '|' | concat: cat_array  | uniq  %}

{% endif %}



{% assign thisCollectionsProductType = 'carpets' %}

{% if collection.products.size > 0 %}
  {% assign thisCollectionsProductTypeCheck = collection.products[0].type | downcase %}
  {% if thisCollectionsProductTypeCheck == "vinyl" %}
    {% assign thisCollectionsProductType = "vinyl-flooring" %}
  {% endif %}
  {% if thisCollectionsProductTypeCheck == "rugs" %}
    {% assign thisCollectionsProductType = "rugs" %}
  {% endif %}


{% endif %}

{% if collection.tags.size > 0 %}
  <div class="filters-close">
    <i class="icon-times"></i>
  </div>
  <div class="collection-filters">
    {% if current_tags %}
      <a href="{{ collection.url }}" class="clear-filters">Clear filters</a>
    {% endif %}
    <h3 class="tt">Filter by</h3>
    <div class="container">
      {% assign markupToOutput = '' %}
      {% assign markupActiveToOutput = '' %}
      {% assign activeButtonsToOutput = '' %}
      {% comment %}
        Loop through tag categories
      {% endcomment %}
      <!-- {{ cat_array }} -->
      {% for cat_item in cat_array %}
        {% assign catLower = cat_item | downcase %}
        {% assign allTagsToOutput = "filter-colour|backing|style|filterlength|width|shade|thick_filter|manufacturer" %}
          {% if allTagsToOutput contains catLower %}

          {% assign thisTile = cat_item | capitalize %}
          {% assign thisTile_class = cat_item | downcase %}

          {% if thisTile == "Filterlength" %}
            {% assign thisTile = "Remnant Length" %}
            {% assign thisTile_class = "Length" %}
          {% endif %}

          {% if thisTile == "Filter-colour" %}
            {% assign thisTile = "Colour" %}
            {% assign thisTile_class = "colour" %}
          {% endif %}

          {% if thisTile == "Thick_filter" %}
            {% assign thisTile = "Thickness" %}
            {% assign thisTile_class = "Thickness" %}
          {% endif %}

          {% assign markupToOutput = markupToOutput | append: '<div id="' | append: thisTile_class | append: '" class="filter-column">' %}
        {% assign markupToOutput = markupToOutput | append: '<h3>' | append: thisTile | append: '</h3><ul class="advanced-filters">' %}
          {% comment %}
            Loop through collection tags
          {% endcomment %}
          {% assign this_loop_counter = 0 %}
          {% for tag in collection.tags %}

            {% assign thisFilter = cat_item | append: '_' %}
            {% if tag contains thisFilter %}

              {% comment %}
                Strip out tag category prefix and add/remove link for tag filtering
              {% endcomment %}
              {% assign tagText = tag | remove_first: thisFilter %}
              {% assign thisTitleTag = "Narrow selection to products matching tag " | append: tag %}
              {% assign currentTitleTag = "Filter by tag " | append: tagText %}
              {% if tagText != blank %}
                {% assign thisTagHandle = tag | handle %}
                {% assign thisSwatch = '' %}
                {% if thisFilter == 'Filter-Colour_' %}
                  {% comment %}<!-- create swatch: /-->{% endcomment %}
                  {% assign swatchSrc = tagText | downcase | append: "-" | append: thisCollectionsProductType | append: ".jpg" | file_img_url: '22x22', crop: 'center' %}
                  {% assign thisSwatch = '<img src="' | append: swatchSrc | append: '">' %}
                {% endif %}

                {% if current_tags contains tag %}
                  {% assign tagTextToAdd = tagText | link_to_remove_tag: tag | replace: thisTitleTag, currentTitleTag %}
                  {% if thisSwatch != '' %}
                    {% assign replacementText = '"> ' | append: thisSwatch %}
                    {% assign tagTextToAdd = tagTextToAdd | replace: '">', replacementText %}
                  {% endif %}
                  {% assign markupToOutput = markupToOutput | append: '<li class="advanced-filter active-filter ' | append: thisFilter | append: '" data-group="' | append: cat_item | append: '" data-handle="' | append: thisTagHandle | append: '">' | append: tagTextToAdd | append: '</li>' %}
                  {% assign hasActive = '' %}
                  {% assign removeTitle = 'Remove filter ' | append: tagText %}
                  {% assign activeButton = tagText | link_to_remove_tag: tag | replace: thisTitleTag, removeTitle | replace: '</a>', ' <span class="active-filter-buttons__remove" aria-hidden="true">&times;</span></a>' %}
                  {% assign activeButtonsToOutput = activeButtonsToOutput | append: '<li class="' | append: thisFilter | append: '" data-handle="' | append: thisTagHandle | append: '">' | append: activeButton | append: '</li>' %}
                  {% assign markupActiveToOutput = markupActiveToOutput | append: '<li class="advanced-filter active-filter ' | append: thisFilter | append: '" data-group="' | append: cat_item | append: '" data-handle="' | append: thisTagHandle | append: '">' | append: tagTextToAdd | append: '</li>' %}
                {% else %}
                  {% assign tagTextToAdd = tagText | link_to_add_tag: tag | replace: thisTitleTag, currentTitleTag %}
                  {% if thisSwatch != '' %}
                    {% assign replacementText = '"> ' | append: thisSwatch %}
                    {% assign tagTextToAdd = tagTextToAdd | replace: '">', replacementText %}
                  {% endif %}
                  {% assign markupToOutput = markupToOutput | append: '<li class="advanced-filter ' | append: thisFilter | append: '" data-group="' | append: cat_item | append: '" data-handle="' | append: thisTagHandle | append: '">' | append: tagTextToAdd | append: '</li>' %}
                {% endif %}
                {% assign this_loop_counter = this_loop_counter | plus: 1 %}
                {% assign loopCount = this_loop_counter | modulo: 8 %}
              {% endif %}
            {% endif %}
          {% endfor %}
          {% assign markupToOutput = markupToOutput | append: '</ul>' %}
          {% assign markupToOutput = markupToOutput | append: '</div>' %}
        {% endif %}
      {% endfor %}

      {% if hasActive %}
        {% assign clearAllToAdd = 'Clear All' | link_to: collection.url %}
        {% assign markupActiveToOutput = markupActiveToOutput | prepend: '<ul id="filters-current">' %}
        {% assign markupActiveToOutput = markupActiveToOutput | append: '<li class="clear-all"' | append: '">' | append: clearAllToAdd | append: '</li>' %}
        {% assign markupActiveToOutput = markupActiveToOutput | append: '</ul>' %}
      {% endif %}

      {% comment %} The selected filters as buttons at the top; clicking one removes it {% endcomment %}
      {% if activeButtonsToOutput != '' %}
        <ul class="active-filter-buttons">{{ activeButtonsToOutput }}</ul>
      {% endif %}

      {{ markupToOutput }}
    </div>
  <!-- <a href="" data-link="{{collection.url}}" class="submit-filters button">Apply Filter</a> -->
  </div>
  {% comment %} {{ markupActiveToOutput }} {% endcomment %}
{% endif %}

{% comment %}
  Filters, sorting and pagination load asynchronously: the target URL is fetched and the
  .col-left (filters) and .col-main (toolbar, grid, pagination) markup is swapped in.
  Filter links come from link_to_add_tag / link_to_remove_tag, so tags in any group combine
  (Shopify returns products matching ALL the selected tags).
  Sits outside the collection.tags check so sorting and pagination still work when no filters show.
{% endcomment %}
<style>
  .collection-product .col-main { transition: opacity .2s ease; }
  /* #ba3c3d is $wilson-red in src/styles/_variables.scss */
  .collection-filters .clear-filters { display: inline-block; margin-top: 20px; margin-bottom: 15px; color: #ba3c3d; font-weight: 700; text-decoration: underline; }
  .collection-filters .clear-filters:hover { color: #ba3c3d; text-decoration: none; }
  @media (max-width: 1023px) {
    .collection-filters .clear-filters { margin-left: 1.875rem; }
  }
  .collection-filters .active-filter-buttons { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 15px; padding: 0; list-style: none; }
  .collection-filters .active-filter-buttons li { margin: 0; padding: 0; }
  .collection-filters .active-filter-buttons a { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border: 1px solid #ba3c3d; border-radius: 999px; background: #fff; color: #ba3c3d; font-size: 14px; line-height: 1.2; text-decoration: none; }
  .collection-filters .active-filter-buttons a:hover,
  .collection-filters .active-filter-buttons a:focus { background: #ba3c3d; color: #fff; }
  .collection-filters .active-filter-buttons__remove { font-size: 16px; line-height: 1; }
  .collection-product.is-loading .col-main,
  .collection-product.is-loading .collection-filters { opacity: .5; pointer-events: none; }
</style>
<script>
  // Lets section-level sort handlers know sorting is handled here without a reload
  window.asyncTagFilters = true;

  jQuery(function($) {
    var defaultSortBy = {{ collection.default_sort_by | json }};
    var $doc = $(document);
    var currentRequest = null;
    var isMobile = false;

    // device detection
    if(/(android|bb\d+|meego).+mobile|avantgo|bada\/|blackberry|blazer|compal|elaine|fennec|hiptop|iemobile|ip(hone|od)|ipad|iris|kindle|Android|Silk|lge |maemo|midp|mmp|netfront|opera m(ob|in)i|palm( os)?|phone|p(ixi|re)\/|plucker|pocket|psp|series(4|6)0|symbian|treo|up\.(browser|link)|vodafone|wap|windows (ce|phone)|xda|xiino/i.test(navigator.userAgent)
    || /1207|6310|6590|3gso|4thp|50[1-6]i|770s|802s|a wa|abac|ac(er|oo|s\-)|ai(ko|rn)|al(av|ca|co)|amoi|an(ex|ny|yw)|aptu|ar(ch|go)|as(te|us)|attw|au(di|\-m|r |s )|avan|be(ck|ll|nq)|bi(lb|rd)|bl(ac|az)|br(e|v)w|bumb|bw\-(n|u)|c55\/|capi|ccwa|cdm\-|cell|chtm|cldc|cmd\-|co(mp|nd)|craw|da(it|ll|ng)|dbte|dc\-s|devi|dica|dmob|do(c|p)o|ds(12|\-d)|el(49|ai)|em(l2|ul)|er(ic|k0)|esl8|ez([4-7]0|os|wa|ze)|fetc|fly(\-|_)|g1 u|g560|gene|gf\-5|g\-mo|go(\.w|od)|gr(ad|un)|haie|hcit|hd\-(m|p|t)|hei\-|hi(pt|ta)|hp( i|ip)|hs\-c|ht(c(\-| |_|a|g|p|s|t)|tp)|hu(aw|tc)|i\-(20|go|ma)|i230|iac( |\-|\/)|ibro|idea|ig01|ikom|im1k|inno|ipaq|iris|ja(t|v)a|jbro|jemu|jigs|kddi|keji|kgt( |\/)|klon|kpt |kwc\-|kyo(c|k)|le(no|xi)|lg( g|\/(k|l|u)|50|54|\-[a-w])|libw|lynx|m1\-w|m3ga|m50\/|ma(te|ui|xo)|mc(01|21|ca)|m\-cr|me(rc|ri)|mi(o8|oa|ts)|mmef|mo(01|02|bi|de|do|t(\-| |o|v)|zz)|mt(50|p1|v )|mwbp|mywa|n10[0-2]|n20[2-3]|n30(0|2)|n50(0|2|5)|n7(0(0|1)|10)|ne((c|m)\-|on|tf|wf|wg|wt)|nok(6|i)|nzph|o2im|op(ti|wv)|oran|owg1|p800|pan(a|d|t)|pdxg|pg(13|\-([1-8]|c))|phil|pire|pl(ay|uc)|pn\-2|po(ck|rt|se)|prox|psio|pt\-g|qa\-a|qc(07|12|21|32|60|\-[2-7]|i\-)|qtek|r380|r600|raks|rim9|ro(ve|zo)|s55\/|sa(ge|ma|mm|ms|ny|va)|sc(01|h\-|oo|p\-)|sdk\/|se(c(\-|0|1)|47|mc|nd|ri)|sgh\-|shar|sie(\-|m)|sk\-0|sl(45|id)|sm(al|ar|b3|it|t5)|so(ft|ny)|sp(01|h\-|v\-|v )|sy(01|mb)|t2(18|50)|t6(00|10|18)|ta(gt|lk)|tcl\-|tdg\-|tel(i|m)|tim\-|t\-mo|to(pl|sh)|ts(70|m\-|m3|m5)|tx\-9|up(\.b|g1|si)|utst|v400|v750|veri|vi(rg|te)|vk(40|5[0-3]|\-v)|vm40|voda|vulc|vx(52|53|60|61|70|80|81|83|85|98)|w3c(\-| )|webc|whit|wi(g |nc|nw)|wmlb|wonu|x700|yas\-|your|zeto|zte\-/i.test(navigator.userAgent.substr(0,4))) {
      isMobile = true;
    }

    // Reorder filters
    var hasNumber = /^\d/;
    var matchnumber = /\d+/g;
    var sizes = ['100%POLYPROPYLENE', '100%POLYAMIDE', '100%WOOL', 'WOOLMIX'];
    var shades = ['GREY', 'BEIGE', 'BROWN', 'CREAM', 'BLACK', 'RED', 'BLUE', 'PINK', 'PURPLE', 'GREEN', 'YELLOW', 'WHITE', 'MULTI'];
    var thickness = ['UNDER8MM','8MMTO12MM', '8MM-12MM', 'OVER12MM', ];
    var length = ['BELOW1M', '1MTO2M', '2MTO3M', '3MTO4M', '4MTO5M', '5MTO6M', 'ABOVETO6M',];
    var width = ['4M', '5M', '2M', '1M'];
    var style = ['TWISTPILE', 'LOOPPILE', 'DEEPPILESAXONY', "KIDS/CHILDRENS", 'SPARKLE', 'CUTANDLOOPPILE' ,'OUTDOORCARPET'];
    var backing = ['FELTBACKING', 'ACTION(HESSIAN)BACKING', 'FUSIONBACKING', 'GELBACKING', 'WOVENBACKING','FOAMBACKING'];

    var sortFunc = function(data) {
      return data.sort(function(a, b) {
        return (a.txt < b.txt) ? -1 : (a.txt > b.txt) ? 1 : 0;
      });
    };

    function reorderFilters() {
      $('.advanced-filters').each(function() {
        var $filters = $(this);
        var toObj = [];
        var $li = $('> li', $filters);
        var firstItemTxt = $('> li:first-child a', $filters).text().toUpperCase().replace(/ /g, '');
        var isSizeOrShade = null;
        var reorder = [];

        [sizes, shades, length, width, style, backing, thickness].forEach(function(list) {
          if (list.indexOf(firstItemTxt) !== -1) {
            isSizeOrShade = list;
          }
        });

        // For case Sizes
        if (isSizeOrShade) {
          var copy = JSON.parse(JSON.stringify(isSizeOrShade));

          $li.each(function() {
            var txt = $('a', $(this)).text().toUpperCase().replace(/ /g, '');
            var idx = isSizeOrShade.indexOf(txt);
            if (idx !== -1) {
              copy[idx] = {el: $(this)};
            }
          });

          $li.each(function() {
            var txt = $('a', $(this)).text().toUpperCase().replace(/ /g, '');
            var idx = isSizeOrShade.indexOf(txt);
            if (idx === -1) {
              copy.push({el: $(this)});
            }
          });
          reorder = copy.filter(function(e) { return typeof e === 'object'; });
        } else { // For case Alphabet, order number from least to greatest
          var numberNoUnit = [];
          $li.each(function() {
            var $liThis = $(this);
            var txt = $('a', $liThis).text().toUpperCase();
            if (isNaN(+txt)) {
              if (hasNumber.test(txt)) {
                txt = +txt.match(matchnumber).join('.');
              }
              toObj.push({txt: txt, el: $liThis});
            } else {
              numberNoUnit.push({txt: +txt, el: $liThis});
            }
          });
          reorder = sortFunc(numberNoUnit).concat(sortFunc(toObj));
        }
        $filters.empty();
        reorder.forEach(function(e) {
          $filters.append(e.el);
        });
      });
    }

    function setSorter(url) {
      var sortBy = new URL(url, window.location.origin).searchParams.get('sort_by');
      $('.collection-product .sort-by').val(sortBy || defaultSortBy);
    }

    // Remembers which filter groups the shopper has opened/closed, so the swapped-in filters match
    function getColumnState() {
      var state = {};
      $('.collection-filters .filter-column').each(function() {
        var $column = $(this);
        state[this.id] = {
          active: $column.children('h3').hasClass('active'),
          hidden: $column.children('.advanced-filters').css('display') === 'none'
        };
      });
      return state;
    }

    function restoreColumnState(state) {
      $('.collection-filters .filter-column').each(function() {
        var columnState = state[this.id];
        if (!columnState) return;
        var $column = $(this);
        $column.children('h3').toggleClass('active', columnState.active);
        $column.children('.advanced-filters').toggle(!columnState.hidden);
      });
    }

    function loadResults(url, pushToHistory, scrollToResults) {
      var $wrapper = $('.collection-product').first();
      var $results = $wrapper.find('.col-main').first();
      var $filters = $wrapper.find('.col-left').first();

      if (!$results.length) {
        window.location.href = url;
        return;
      }

      if (currentRequest) {
        currentRequest.abort();
      }

      $wrapper.addClass('is-loading');

      currentRequest = $.ajax({ url: url, dataType: 'html' })
        .done(function(html) {
          var remote = new DOMParser().parseFromString(html, 'text/html');
          var remoteWrapper = remote.querySelector('.collection-product');
          var remoteResults = remoteWrapper && remoteWrapper.querySelector('.col-main');
          var remoteFilters = remoteWrapper && remoteWrapper.querySelector('.col-left');

          // Unexpected markup (e.g. Shopify served an error page): fall back to a normal page load
          if (!remoteResults) {
            window.location.href = url;
            return;
          }

          // Scripts in fetched markup don't run, so drop them (incl. the "no products" redirect)
          $(remote).find('.collection-product script').remove();

          var columnState = getColumnState();

          $results.html(remoteResults.innerHTML);
          if (remoteFilters && $filters.length) {
            $filters.html(remoteFilters.innerHTML);
            reorderFilters();
            restoreColumnState(columnState);
          }
          setSorter(url);

          if (remote.title) {
            document.title = remote.title;
          }

          if (pushToHistory) {
            history.pushState({ tagFilters: true }, '', url);
          }

          if (scrollToResults) {
            var top = $results.offset().top - 20;
            if ($(window).scrollTop() > top) {
              $('html, body').animate({ scrollTop: top }, 200);
            }
          }
        })
        .fail(function(xhr, status) {
          if (status !== 'abort') {
            window.location.href = url;
          }
        })
        .always(function(data, status) {
          if (status !== 'abort') {
            currentRequest = null;
            $wrapper.removeClass('is-loading');
          }
        });
    }

    // Keeps the current sort and drops the page number, so a new filter starts on page 1
    function buildFilterUrl(href) {
      var url = new URL(href, window.location.origin);
      var currentSort = new URL(window.location.href).searchParams.get('sort_by');
      url.searchParams.delete('page');
      if (currentSort && !url.searchParams.has('sort_by')) {
        url.searchParams.set('sort_by', currentSort);
      }
      return url.toString();
    }

    // Tag filters: add/remove the tag, any number at once, without reloading
    $doc.on('click', '.collection-filters .advanced-filter a, .collection-filters .active-filter-buttons a', function(e) {
      e.preventDefault();
      loadResults(buildFilterUrl(this.href), true, false);
    });

    // Clear filters goes back to the collection URL, and slides the mobile filter panel out (same breakpoint as main.css)
    $doc.on('click', '.collection-filters .clear-filters', function(e) {
      e.preventDefault();
      if (window.matchMedia('(max-width: 63.99em)').matches) {
        $('body').removeClass('open-filter');
      }
      loadResults(buildFilterUrl(this.href), true, false);
    });

    // Sorting
    $doc.on('change', '.collection-product .sort-by', function() {
      var url = new URL(window.location.href);
      url.searchParams.set('sort_by', $(this).val());
      url.searchParams.delete('page');
      loadResults(url.toString(), true, false);
    });

    // Pagination
    $doc.on('click', '.collection-product .collection-pagination a', function(e) {
      e.preventDefault();
      loadResults(this.href, true, true);
    });

    // Filter group show/hide
    $doc.on('click', '.collection-filters .filter-column h3', function() {
      $(this).toggleClass('active').next().slideToggle();
    });

    // Mobile filter panel. all.js binds these directly, which is lost once the markup is swapped
    $doc.on('click', '.collection-product .js-filter-by', function() {
      $('body').addClass('open-filter');
    });
    $doc.on('click', '.collection-product .filters-close', function() {
      $('body').removeClass('open-filter');
    });

    // Back/forward
    history.replaceState({ tagFilters: true }, '', window.location.href);
    window.addEventListener('popstate', function(e) {
      if (e.state && e.state.tagFilters) {
        loadResults(window.location.href, false, false);
      }
    });

    reorderFilters();

    if (isMobile) {
      $('.filter-column').not(':first').each(function() {
        $(this).find('.advanced-filters').hide();
      });
    }
  });
</script>
