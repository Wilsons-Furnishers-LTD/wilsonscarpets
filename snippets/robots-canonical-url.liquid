		{% endif %}

		{% if product.type == "Sample" %}
			{% for tag in productTags %}
				{% if tag contains 'parent_'%}
					{% assign parent_url_p = tag | replace: 'parent_', '' %}
					{% assign canonical = shop.url | append: '/products/' | append: parent_url_p %}
					{% break %}
				{% endif %}
			{% endfor %}
		{% endif %}
	{% endif  %}

	{% comment %} {% assign robots_meta = robots_meta | strip %} {% endcomment %}

	{% if template.name == '404' %}
		<script>
			const href = window.location.href;
			const re = /(.*?)(-\d?-?\d*m-x)/;
			const found = href.match(re);
			if(found.length > 2){
				var xmlhttp = new XMLHttpRequest();

				xmlhttp.onreadystatechange = function() {
					if (xmlhttp.readyState == XMLHttpRequest.DONE) {   // XMLHttpRequest.DONE == 4
						if (xmlhttp.status == 200) {
							//console.log(xmlhttp.response)
							var link=document.createElement('link');
							link.href=found[1];
							link.rel='canonical';
							document.head.appendChild(link);

							window.location = found[1];
						}
						else if (xmlhttp.status == 400) {
							//alert('There was an error 400');
						}
						else {
							//alert('something else other than 200 was returned');
						}
					}
				};

				xmlhttp.open("GET", found[1] + '.js', true);
				xmlhttp.send();
			}
		</script>
	{% else %}

		{% if haveCanonical %}
			<link rel="canonical" href="{{ canonical | split: "?" | first }}" />
		{% else %}
			<link rel="canonical" href="" />
		{% endif %}
	{% endif %}

	{% if robots_meta != '' %}
			{{ robots_meta }}
	{% endif %}
