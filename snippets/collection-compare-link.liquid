{%- comment -%}
  In collection toolbars, shown when a product on the page has a compare button
  (the types match snippets/compare-button.liquid). compare.js opens the compare modal from here,
  or points at the first compare button when nothing has been added yet.
  Rendered twice, as placement 'sorter' next to "Sort by" from 1024px, and 'pagination' left of the
  pagination below that, where the filter and sort bar is moved out of the toolbar
{%- endcomment -%}


{% if shop.metafields.custom.compare_feature.value %}
  {% assign compare_types = 'Carpets|LVT|Vinyl|Laminate|Artificial Grass|Real Wood|Accessories & Underlay|Rugs' | split: '|' %}
  {% assign has_comparable_product = false %}
  {% for product in collection.products %}
    {% if compare_types contains product.type %}
      {% assign has_comparable_product = true %}
      {% break %}
    {% endif %}
  {% endfor %}

  {% if has_comparable_product %}
    <div class="collection-compare collection-compare--{{ placement }}">
      <a href="/pages/compare" class="collection-compare__link" aria-label="Compare products">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 8h16"/>
          <path d="m16 4 4 4-4 4"/>
          <path d="M20 16H4"/>
          <path d="m8 12-4 4 4 4"/>
        </svg>
        <span class="collection-compare__text">Compare</span>
      </a>
    </div>
  {% endif %}
{% endif %}
