<a href="#" id="toggleCMSNav">{{ block.settings.cms_heading }}</a>
<div id="informational-pages">
    
	{% assign cms_linklist = block.settings.cms_linklist %}
	{% if linklists[cms_linklist].links.size > 0 %}
	<h3>{{ linklists[cms_linklist].title }}</h3>
	<ul>
		{% for link in linklists[cms_linklist].links %}
		<li {% if page_title == link.title %}class="active"{% endif %}>
			<a href="{{ link.url }}">{{ link.title }}</a>
		</li>
		{% endfor %}
	</ul>
	{% endif %}
