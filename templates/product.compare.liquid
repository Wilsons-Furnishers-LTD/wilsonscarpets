{%- layout none -%}
{%- comment -%}
  Product data for the compare table (src/scripts/compare.js), fetched with ?view=compare.
  The same as products/{handle}.js, plus the Juno metafields the product page uses for stock.
{%- endcomment -%}

{%- comment -%} Matches the stock status logic in snippets/product-details-top.liquid {%- endcomment -%}
{%- assign stockAvailability = '' -%}
{%- if product.variants.size > 1 -%}
  {%- assign stockAvailability = 'Out of stock' -%}
  {%- for variant in product.variants -%}
    {%- if variant.metafields.Juno.is_in_stock != '0' -%}
      {%- assign stockAvailability = 'In stock' -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- else -%}
  {%- if product.metafields.Juno.is_in_stock != '0' -%}
    {%- if product.metafields.Juno.lowstock == 'Yes' -%}
      {%- assign stockAvailability = 'Order Now' -%}
    {%- else -%}
      {%- assign stockAvailability = 'In Stock' -%}
    {%- endif -%}
  {%- else -%}
    {%- assign stockAvailability = 'Out of stock' -%}
  {%- endif -%}
{%- endif -%}

{
  "product": {{ product | json }},
  "metafields": {
    "is_in_stock": {{ product.metafields.Juno.is_in_stock.value | json }},
    "lowstock": {{ product.metafields.Juno.lowstock.value | json }},
    "delivery_time": {{ product.metafields.Juno.Delivery_time.value | json }},
    "stock_status": {{ stockAvailability | json }},
    "variants": [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id | json }},
          "is_in_stock": {{ variant.metafields.Juno.is_in_stock.value | json }},
          "lowstock": {{ variant.metafields.Juno.lowstock.value | json }},
          "delivery_time": {{ variant.metafields.Juno.Delivery_time.value | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
}
