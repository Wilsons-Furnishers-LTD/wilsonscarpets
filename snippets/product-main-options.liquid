                                                                        </div>
                                                                    {% endif %}
                                                            {% endfor %}
                                                        {{ value }}
                                                    </span>
                                                {% endif %}
                                            {% else %}
                                                {% if forloop.first == true %}
                                                    <span class="data">
                                                        {% for color_value in values %}
                                                                {% assign value_variants = productData.variants | where: "option1", color_value %}
                                                                    {% if value ==  color_value %}
                                                                        <div class="color-swatch">
                                                                            <img src="{{value_variants[0].image | img_url: '40x40', crop: 'center' }}" alt="{{ value }}" />
                                                                        </div>
                                                                    {% endif %}
                                                            {% endfor %}
                                                        {{ value }}
                                                    </span>
                                                {% endif %}
                                            {% endif %}

                                        {% endfor %}

                                        <!-- Default Dropdown Selected Variant Html End -->

                                    {% endif %}
                                {% endfor %}
                            </label>

                            <ul class="colour-dropdown">
                                {% for option in productData.options_with_values %}
                                    {% if option.name == "Colour" %}
                                        {% for value in option.values %}
                                            <li data-value="{{ value }}"
                                                {% if defaultVariantSelection %}
                                                    {% if defaultVariantSelect == value %}class="selected"{% endif %}
                                                {% else %}
                                                    {% if forloop.first == true %}class="selected"{% endif %}
                                                {% endif %}>
                                                <a href="{{ productData.url }}?color={{ value }}">
                                                <span class="data">
                                                    {% for color_value in values %}
                                                        {% assign value_variants = productData.variants | where: "option1", color_value %}
                                                            {% if value ==  color_value %}
                                                                <div class="color-swatch">
                                                                    <img src="{{value_variants[0].image | img_url: '40x40', crop: 'center' }}" alt="{{ value }}" />
                                                                </div>
                                                            {% endif %}
                                                    {% endfor %}
                                                    {{ value }}
                                                </span>
                                                </a>
                                            </li>
                                        {% endfor %}
                                    {% endif %}
                                {% endfor %}
                            </ul>
                        </div>

                        <!-- Colour Image Grid Section -->

                        <ul class="grid">
                            {% for option in productData.options_with_values %}
                                {% if option.name == "Colour" %}
                                    {% for value in option.values %}
                                        <li data-value="{{ value }}"
                                            {% if defaultVariantSelection %}
                                                {% if defaultVariantSelect == value %}class="selected"{% endif %}
                                            {% else %}
                                                {% if forloop.first == true %}class="selected"{% endif %}
                                            {% endif %}>
                                            <a href="{{ productData.url }}?color={{ value }}">
                                            <span class="data">
                                                {% for color_value in values %}
                                                    {% assign value_variants = productData.variants | where: "option1", color_value %}
                                                        {% if value ==  color_value %}
                                                            <div class="color-swatch">
                                                                <img src="{{value_variants[0].image | img_url: '40x40', crop: 'center' }}" alt="{{ value }}" />
                                                            </div>
                                                        {% endif %}
                                                {% endfor %}
                                            </span>
                                            </a>
                                        </li>
                                    {% endfor %}
                                {% endif %}
                            {% endfor %}
                        </ul>

                        <!-- Colour Image Grid Section End -->

                    </div>
                </div>

            {%- endif -%}

            <!-- Additional Swatches using tag for single product page Code End -->

            <script>
                var freeSampleVariants = [];
                var freeSampleVariantsAvailability = [];
            </script>
                {% if product.type == 'Carpet' or product.type == 'Carpets' or product.type == 'Vinyl' or product.type == 'Artificial Grass'  %}
                    <div class="option option-size" data-select-option="{{ '#product-select-option-' | append: position_option_size }}">
                        <div class="colour-selected">
                            Oatmeal 05
                        </div>
                        <div class="content">
                            <div class="length-qty metres">
                                <div class="size-calculator-header">
                                    <h2>Enter your size</h2>
                                    <div class="toggle-wrapper">
                                        <input type="checkbox" id="toggleMeasurementType" class="toggle-checkbox" />
                                        <label for="toggleMeasurementType" class='toggleContainer'>
                                            <div>Metres</div>   
                                            <div>Feet & Inches</div>
                                        </label>
                                    </div>
                                </div>
                                <div class="qty" id="lengthMetres">
                                    <label for="quantity">Length (m)</label>
                                    {% comment %}<!-- show the SQM price initial - so divide 1 by the width as the initial length value: /-->{% endcomment %}
                                    {% assign lengthInitial = 1 %}
                                    {% if value_sizes.size > 0 %}
                                        {% assign firstWidthNumeric = length_value_sizes | plus: 0 %}
                                        {% assign lengthInitial = 100 | divided_by: firstWidthNumeric | times: 0.01 %}
                                    {% endif %}
                                    {% assign minimumLengthValue = lengthInitial %}

                                    {% if minimumLength != '' %}
                                        {% assign minimumLengthValue = minimumLength %}
                                    {% endif %}
                                    {% if defaultLength != '' %}
                                        {% assign lengthInitial = defaultLength %}
                                    {% endif %}
                                    <input min="{{ minimumLengthValue }}" data-min="{{ minimumLengthValue }}" type="text" inputmode="decimal" value="" pattern="[0-9.]*" id="userLength"/>
                                </div>

                                <div class="qty" id="lengthInches">
                                    <label for="quantity">Length (ft &amp; in)</label>
                                    <input min="0" type="text" inputmode="decimal" pattern="[0-9.]*" id="userLengthFeet"/>
