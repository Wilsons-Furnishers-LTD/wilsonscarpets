{{ 'carousel.css' | asset_url | stylesheet_tag }}
{%- comment -%}
    Image gallery carousel: thumbnails on the left, main image in the middle, text content on the right.
    One block per image. Uses Owl Carousel v2, which layout/theme.liquid already loads (deferred) along with jQuery.
    Styles: src/styles/carousel/_index.scss -> assets/carousel.css (npm run build)
{%- endcomment -%}
<div class="content-carousel" data-section-id="{{ section.id }}" data-section-type="carousel">
    <div class="wrapper">
        <div class="content-carousel__layout{% if section.settings.content == blank and section.settings.title == blank %} content-carousel__layout--no-content{% endif %}">
            <div class="content-carousel__gallery">
                {% if section.blocks.size > 1 %}
                    <ul class="content-carousel__thumbs" aria-label="Choose image">
                        {% for block in section.blocks %}
                            <li>
                                <button type="button"
                                    class="content-carousel__thumb{% if forloop.first %} is-active{% endif %}"
                                    data-index="{{ forloop.index0 }}"
                                    aria-label="Show image {{ forloop.index }} of {{ forloop.length }}"
                                    {% if forloop.first %}aria-current="true"{% endif %}>
                                    {% if block.settings.image != blank %}
                                        {{ block.settings.image | image_url: width: 160, height: 160, crop: 'center' | image_tag: alt: '', loading: 'lazy' }}
                                    {% else %}
                                        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                                    {% endif %}
                                </button>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                {% if section.blocks.size > 0 %}
                    <div class="content-carousel__main">
                        <div class="owl-carousel" id="Carousel-{{ section.id }}"
                            data-autoplay="{{ section.settings.autoplay }}"
                            data-speed="{{ section.settings.autoplay_speed | times: 1000 }}">
                            {% for block in section.blocks %}
                                <div class="content-carousel__slide" {{ block.shopify_attributes }}>
                                    {% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{% endif %}
                                    {% if block.settings.image != blank %}
                                        {{ block.settings.image | image_url: width: 1200 | image_tag:
                                            widths: '540, 800, 1000, 1200',
                                            sizes: '(min-width: 990px) 45vw, 100vw',
                                            alt: block.settings.image.alt,
                                            loading: 'lazy'
                                        }}
                                    {% else %}
                                        {%- capture current -%}{% cycle 1, 2 %}{%- endcapture -%}
                                        {{ 'lifestyle-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                                    {% endif %}
                                    {% if block.settings.link != blank %}</a>{% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            </div>

            {% if section.settings.title != blank or section.settings.content != blank %}
                <div class="content-carousel__content">
                    {% if section.settings.title != blank %}
                        <h2 class="content-carousel__title">{{ section.settings.title | escape }}</h2>
                    {% endif %}
                    {% if section.settings.content != blank %}
                        <div class="content-carousel__text">{{ section.settings.content }}</div>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>
</div>

<script>
    (function () {
        var sectionId = '{{ section.id }}';

        function init() {
            if (!window.jQuery || !jQuery.fn.owlCarousel) return;
            var $main = jQuery('#Carousel-' + sectionId);
            if (!$main.length) return;
            var $thumbs = $main.closest('.content-carousel').find('.content-carousel__thumb');

            $main.trigger('destroy.owl.carousel');
            $thumbs.off('.contentCarousel');

            function setActive(index) {
                $thumbs.removeClass('is-active').removeAttr('aria-current');
                $thumbs.eq(index).addClass('is-active').attr('aria-current', 'true');
            }

            $main.on('changed.owl.carousel', function (e) {
                if (e.item && e.item.index !== null) setActive(e.item.index);
            });

            $main.owlCarousel({
                items: 1,
                loop: false,
                rewind: true,
                nav: false,
                dots: $thumbs.length === 0 ? false : true,
                autoplay: $main.data('autoplay') === true,
                autoplayTimeout: parseInt($main.data('speed'), 10) || 5000,
                autoplayHoverPause: true,
                smartSpeed: 500
            });

            $thumbs.on('click.contentCarousel', function () {
                $main.trigger('to.owl.carousel', [parseInt(jQuery(this).data('index'), 10), 500]);
            });
        }

        // owl.carousel.js is loaded with defer, so wait for it
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }

        // Re-initialise when the section is edited in the theme editor, and jump to a block when it's selected
        document.addEventListener('shopify:section:load', function (e) {
            if (e.detail.sectionId === sectionId) init();
        });
        document.addEventListener('shopify:block:select', function (e) {
            if (e.detail.sectionId !== sectionId || !window.jQuery) return;
            var index = jQuery(e.target).closest('.owl-item').index();
            if (index > -1) jQuery('#Carousel-' + sectionId).trigger('to.owl.carousel', [index, 300]);
        });
    })();
</script>

{% schema %}
    {
        "name": "Carousel",
        "class": "index-section",
        "settings": [
            {
                "type": "text",
                "id": "title",
                "label": "Heading"
            },
            {
                "type": "richtext",
                "id": "content",
                "label": "Content"
            },
            {
                "type": "checkbox",
                "id": "autoplay",
                "label": "Autoplay",
                "default": false
            },
            {
                "type": "range",
                "id": "autoplay_speed",
                "label": "Change images every",
                "min": 3,
                "max": 10,
                "step": 1,
                "unit": "s",
                "default": 5
            }
        ],
        "blocks": [
            {
                "type": "slide",
                "name": "Image",
                "settings": [
                    {
                        "type": "image_picker",
                        "id": "image",
                        "label": "Image"
                    },
                    {
                        "type": "url",
                        "id": "link",
                        "label": "Link"
                    }
                ]
            }
        ],
        "presets": [{
            "name": "Carousel",
            "category": "Image",
            "settings": {
                "content": "<p>Tell customers about this store: what you sell, where to find you and the areas you cover.</p>"
            },
            "blocks": [
                { "type": "slide" },
                { "type": "slide" },
                { "type": "slide" },
                { "type": "slide" }
            ]
        }]
    }
{% endschema %}
