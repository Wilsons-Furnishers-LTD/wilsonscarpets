{% if customer %}
  <script type="text/javascript">
        window.location.href= "/account/"
  </script>
{% else %}
  <div class="account-form login wrapper">
    <div class="row">
      <div class="col-main">
        <div class="section">

          {% form 'customer_login' %}
            <div id="LoginTitle" class="login">
              <h1>
                <span class="CustomerLoginTitle">Hello again</span>
                <span class="RecoverPasswordTitle">
                  {{ 'customer.recover_password.title' | t }}
                  <span>{{ 'customer.recover_password.subtext' | t }}</span>
                </span>
              </h1>
              <p>Log in to your account to view order history and manage your account preferences</p>
            </div>
            <div class="form-success hide" id="ResetSuccess">
              <p>{{ 'customer.recover_password.success' | t }}</p>
            </div>
            <div id="CustomerLoginForm" class="form-box-shadow">
              {{ form.errors | default_errors }}
              <input
                type="email"
                placeholder="{{ 'customer.login.email' | t }}"
                name="customer[email]"
                id="CustomerEmail"
                class="{% if form.errors contains 'email' %} input--error{% endif %}"
                autocorrect="off"
                autocapitalize="off"
                autofocus>
              {% if form.password_needed %}
                <input
                  type="password"
                  placeholder="{{ 'customer.login.password' | t }}"
                  value=""
                  name="customer[password]"
                  id="CustomerPassword"
                  class="{% if form.errors contains 'password' %} input--error{% endif %}">
              {% endif %}
              <div class="text-center buttons-set">
                <input
                  type="submit"
                  class="button "
                  value="{{ 'customer.login.sign_in' | t }}">
                {% if form.password_needed %}
                  <a
                    class="button-text"
                    href="#recover"
                    id="RecoverPassword">{{ 'customer.login.forgot_password' | t }}</a>
                {% endif %}
              </div>
            </div>
          {% endform %}
          <div id="RecoverPasswordForm" class="hide">
            {% form 'recover_customer_password' %}
              {{ form.errors | default_errors }}
              {% if form.posted_successfully? %}
                <span class="hide reset-password-success"></span>
              {% endif %}
              <input
                type="email"
                placeholder="{{ 'customer.recover_password.email' | t }}"
                value=""
                name="email"
                id="RecoverEmail"
                class="input-full"
                autocorrect="off"
                autocapitalize="off">

              <div class="text-center buttons-set">
                <input
                  type="submit"
                  class="button"
                  value="{{ 'customer.recover_password.submit' | t }}" />
                <a
                  href="#"
                  id="HideRecoverPasswordLink"
                  class="button-text">{{ 'customer.recover_password.cancel' | t }}</a>
              </div>
            {% endform %}
          </div>
        </div>
      </div>
      <div class="col-right">
        <div class="new-customer">
          <h2>Not been here before?</h2>
          <p>You can create an account when you checkout and pay or set one up here</p>
          <a class="button" href="/account/register">Create account</a>
        </div>
      </div>
    </div>
  </div>
{% endif %}
