[
  {
    "name": "Welcome",
    "settings": [
      {
        "type": "paragraph",
        "content": "Theme settings allow designers to provide an easy way for any user to customize the look and feel of their shop without having to delve into HTML or CSS code. Please see our [help page on theme settings](http://docs.shopify.com/themes/theme-templates/settings) to learn more about how you can make your theme customizable."
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Background"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background color"
      },
      {
        "type": "header",
        "content": "Text"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text color"
      },
      {
        "type": "color",
        "id": "link_color",
        "label": "Link color"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Body Font"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "assistant_n4",
        "label": "Font",
        "info": "Selecting a different font can affect the speed of your store."
      },
      {
        "type": "header",
        "content": "Header Font"
      },
      {
        "type": "font_picker",
        "id": "type_header_font",
        "default": "assistant_n4",
        "label": "Font",
        "info": "Selecting a different font can affect the speed of your store."
      }
    ]
  },
  {
    "name": "Header",
    "settings": [
      {
        "type": "header",
        "content": "Logo Options"
      },
      {
        "type": "checkbox",
        "id": "use_logo",
        "label": "Use Custom Logo?"
      },
      {
        "type": "image",
        "id": "logo.png",
        "label": "Custom Logo",
        "max-width": 1200,
        "max-height": 1200
      },
      {
        "type": "paragraph",
        "content": "Recommend the optimal width and height for your logo here."
      },
      {
        "type": "header",
        "content": "Google Tag Manager"
      },
      {
        "type": "paragraph",
        "content": "Just the id required - for example 'GTM-ABCD1EF'. Leave this blank to not use GTM."
      },
      {
        "type": "text",
        "id": "gtm_code",
        "label": "GTM Identifier"
      },
      {
        "type": "header",
        "content": "Social links"
      },
      {
        "type": "paragraph",
        "content": "All links, except the email one, must begin with http://, https:// or //. The email must be your email address with no mailto: prefix. Leave the text box blank if you don't want to use the corresponding icon."
      },
      {
        "type": "text",
        "id": "facebook_url",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "twitter_url",
        "label": "Twitter URL"
      },
      {
        "type": "text",
        "id": "pinterest_url",
        "label": "Pinterest URL"
      },
      {
        "type": "text",
        "id": "googleplus_url",
        "label": "Google+ URL"
      },
      {
        "type": "text",
        "id": "flickr_url",
        "label": "Flickr URL"
      },
      {
        "type": "text",
        "id": "instagram_url",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "linkedin_url",
        "label": "Linkedin URL"
      },
      {
        "type": "text",
        "id": "vimeo_url",
        "label": "Vimeo URL"
      },
      {
        "type": "text",
        "id": "youtube_url",
        "label": "Youtube URL"
      },
      {
        "type": "text",
        "id": "tumblr_url",
        "label": "Tumblr URL"
      },
      {
        "type": "text",
        "id": "wordpress_url",
        "label": "Wordpress URL"
      },
      {
        "type": "text",
        "id": "yelp_url",
        "label": "Yelp URL"
      },
      {
        "type": "text",
        "id": "contact_email",
        "label": "Email"
      },
      {
        "type": "blog",
        "id": "featured_blog",
        "label": "Blog feed"
      },
      {
        "type": "select",
        "id": "social_icons_style",
        "label": "Social icons style",
        "options": [
          {
            "value": "",
            "label": "Silhouette"
          },
          {
            "value": "-circle",
            "label": "Circle"
          },
          {
            "value": "-rounded",
            "label": "Rounded corners"
          },
          {
            "value": "-square",
            "label": "Square"
          }
        ]
      }
    ]
  },
  {
    "name": "Homepage",
    "settings": [
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "page",
        "id": "homepage_page",
        "label": "Show content of this page!"
      },
      {
        "type": "header",
        "content": "Featured collection"
      },
      {
        "type": "collection",
        "id": "homepage_collection",
        "label": "Feature products from this collection"
      }
    ]
  },
  {
    "name": "Custom scripts",
    "settings": [
      {
        "type": "header",
        "content": "Scripts for tracking and analytics"
      },
      {
        "type": "liquid",
        "id": "head_scripts",
        "label": "Scripts for site head"
      },
      {
        "type": "liquid",
        "id": "body_scripts",
        "label": "Scripts for site body"
      }
    ]
  },
  {
    "name": "Collection pages",
    "settings": [
      {
        "type": "header",
        "content": "Product Grid"
      },
      {
        "type": "select",
        "id": "products_per_row",
        "label": "Number of products per row",
        "options": [
          {
            "value": "2",
            "label": "2"
          },
          {
            "value": "3",
            "label": "3"
          },
          {
            "value": "4",
            "label": "4"
          },
          {
            "value": "5",
            "label": "5"
          },
          {
            "value": "6",
            "label": "6"
          }
        ],
        "default": "4"
      },
      {
        "type": "select",
        "id": "number_of_rows",
        "label": "Number of rows",
        "options": [
          {
            "value": "1",
            "label": "1"
          },
          {
            "value": "2",
            "label": "2"
          },
          {
            "value": "3",
            "label": "3"
          },
          {
            "value": "4",
            "label": "4"
          },
          {
            "value": "5",
            "label": "5"
          },
          {
            "value": "6",
            "label": "6"
          },
          {
            "value": "7",
            "label": "7"
          },
          {
            "value": "8",
            "label": "8"
          },
          {
            "value": "12",
            "label": "12"
          },
          {
            "value": "14",
            "label": "14"
          },
          {
            "value": "17",
            "label": "17"
          },
          {
            "value": "20",
            "label": "20"
          }
        ],
        "default": "3"
      },
      {
        "type": "radio",
        "id": "collection_sidebar_filters",
        "label": "Collection product filters",
        "options": [
          {
            "value": "tags",
            "label": "By tag"
          },
          {
            "value": "groups",
            "label": "By group"
          }
        ],
        "info": "[Learn how to set up filter groups](https://help.shopify.com/manual/using-themes/themes-by-shopify/supply#product-tips-tips-specific)."
      }
    ]
  },
  {
    "name": "Free delivery",
    "settings": [
      {
        "type": "checkbox",
        "id": "free_delivery_enabled",
        "default": false,
        "label": "Enabled?",
        "info": "Show free delivery progress bar on cart page"
      },
      {
        "type": "number",
        "id": "free_delivery_threshold",
        "default": 0,
        "label": "Threshold",
        "info": "Minimum order value for free delivery, in pence. i.e. 1000 = £10"
      }
    ]
  },
]
