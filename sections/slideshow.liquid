{% for block in section.blocks %}
    {% if block.settings.text_color == 'custom' %}
    <style>
        #block-{{block.id}} .text-content{
            color: {{block.settings.custom_text_color}};
        }
    </style>
    {% endif %}
{% endfor %}
<div class="banner-one slideshow" data-section-id="{{ section.id }}" data-section-type="slideshow-section">
    {% comment %}
    {% if section.settings.show_free %}
    <div class="free-fast-delivery">
        <div class="wrapper">
            <div class="free-box">
                <span class="free-icon">
                    <i class="icon-truck"></i>
                </span>
                <span class="free-txt">
                    <strong>{{ section.settings.free_title }}</strong>
                    <span>{{ section.settings.free_price }}</span>
                </span>
            </div>
        </div>
    </div>
    {% endif %}
    {% endcomment %}
    {% if section.blocks.size > 0 %}
        <div class="owl-carousel" id="Slideshow-{{ section.id }}">
            {% for block in section.blocks %}

            

            <div class="col-img {{ block.settings.text_color | escape }}" id="block-{{block.id}}">
                {% if block.settings.link != blank %}
                <a class="col-img__link" href="{{ block.settings.link }}"></a>
                {% endif %}
                {% if block.settings.image %}
                    <picture>
                        <source media="(min-width: 1440px)" srcset="{{ block.settings.image | img_url: 'master' }}">
                        <source media="(min-width: 1390px)" srcset="{{ block.settings.image | img_url: '1440x' }}">
                        <source media="(min-width: 1340px)" srcset="{{ block.settings.image | img_url: '1390x' }}">
                        <source media="(min-width: 1280px)" srcset="{{ block.settings.image | img_url: '1340x' }}">
                        <source media="(min-width: 1024px)" srcset="{{ block.settings.image | img_url: '1280x' }}">
                        <source media="(min-width: 768px)" srcset="{{ block.settings.image | img_url: '1024x500', crop: 'center' }}">
                        {% if block.settings.mobile_image != blank %}
                            <source media="(min-width: 540px)" srcset="{{ block.settings.mobile_image | img_url: 'master' }}">
                        {% else %}
                            <source media="(min-width: 540px)" srcset="{{ block.settings.image | img_url: '640x500', crop: 'center' }}">
                        {% endif %}
                        {% if block.settings.mobile_image != blank %}
                            <source srcset="{{ block.settings.mobile_image | img_url: '540x' }}">
                        {% else %}
                            <source srcset="{{ block.settings.image | img_url: '540x506', crop: 'center' }}">
                        {% endif %}

                        <img width="1440" height="522" loading="lazy" src="{{ block.settings.image | img_url: 'master' }}" alt="" {% unless forloop.first %} importance="low" {% endunless %}>
                    </picture>
                {% else %}
                    <span class="placeholder-background">
                        {% capture current %}{% cycle 1, 2 %}{% endcapture %}
                        {{ 'lifestyle-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                    </span>
                {% endif %}
                {% if block.settings.icon %}
                    <div class="icon">
                        <div class="wrapper">
                            {% if block.settings.link_icon != blank %}
                            <a href="{{ block.settings.link_icon }}">
                            {% endif %}
                            <picture>
                                <img width="253" height="71" src="{{ block.settings.icon | img_url: 'master' }}" alt="" loading="lazy" importance="low" />
                            </picture>
                            {% if block.settings.link_icon != blank %}
                            </a>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
                <div class="text-wrap overlay">
                    {%- if block.settings.link != blank -%}
                    <a href="{{ block.settings.link }}">
                    {%- endif -%}
                    <div class="wrapper">
                        <div class="text-content">
                            {% unless block.settings.title == blank %}
                            <h2 class="title">{{ block.settings.title }}</h2>
                            {% endunless %}
                            {% unless block.settings.subheading == blank %}
                            <p class="subtitle">{{ block.settings.subheading }}</p>
                            {% endunless %}
                            {% if block.settings.button_text != blank %}
                            <span class="button">{{ block.settings.button_text }}</span>
                            {% endif %}
                        </div>
                    </div>
                    {%- if block.settings.link != blank -%}
                    </a>
                    {%- endif -%}
                </div>
            </div>
            {% endfor %}
        </div>
    {% endif %}
</div>

{% schema %}
    {
        "name": "Slideshow",
        "class": "index-section",
        "max_blocks": 10,
        "blocks": [
            {
                "type": "image",
                "name": "Banner",
                "settings": [
                    {
                        "type": "image_picker",
                        "id": "image",
                        "label": "Image"
                    },
                    {
                        "type": "image_picker",
                        "id": "mobile_image",
                        "label": "Mobile Image"
                    },
                    {
                        "type": "select",
                        "id": "text_color",
                        "label": "Text color",
                        "options": [
                            { "value": "text-light", "label": "Light" },
                            { "value": "text-dark", "label": "Dark" },
                            { "value": "custom", "label": "Custom" }
                        ],
                        "default": "text-light"
                    },
                    {
                        "type": "color",
                        "id": "custom_text_color",
                        "label": "Custom text color",
                        "default": "#000000"
                    },
                    {
                        "type": "text",
                        "id": "title",
                        "label": "Heading",
                        "default": "Image slide"
                    },
                    {
                        "type": "text",
                        "id": "subheading",
                        "label": "Subheading",
                        "default": "Lorem ipsum dolor sit amet, consectetur"
                    },
                    {
                        "type": "url",
                        "id": "link",
                        "label": "Link"
                    },
                    {
                        "type": "image_picker",
                        "id": "icon",
                        "label": "Icon"
                    },
                    {
                        "type": "url",
                        "id": "link_icon",
                        "label": "Icon Link"
                    },
                    {
                        "type": "text",
                        "id": "button_text",
                        "label": "Button Text",
                        "default": "Shop Now"
                    }
                ]
            }
        ],
        "presets": [{
            "name": "Slideshow",
            "category": "Image",
            "blocks": [
                {
                "type": "image"
                },
                {
                "type": "image"
                }
            ]
        }]
    }
{% endschema %}
