{% assign name = metaobject.name %}
{% assign address = metaobject.address %}
{% assign telephone = metaobject.telephone %}
{% assign email = metaobject.email %}
{% assign opening_times = metaobject.store_opening_times %}
{% assign store_details = metaobject.store_details %}
{% assign banner_image = metaobject.store_banner_image %}
{{banner_image}}
{%- comment -%} Assumed field names for the photo and the button to another store's page {%- endcomment -%}
{% assign image = metaobject.image %}
{% assign other_store = metaobject.other_store.value %}

{%- liquid
  assign address_text = address.value | strip
  # "Wheatley Hall Road\nDoncaster" -> "Wilsons Carpets, Wheatley Hall Road, Doncaster" for Google Maps
  assign address_one_line = address_text | newline_to_br | replace: '<br />', ', ' | strip_newlines
  assign destination = shop.name | append: ', ' | append: address_one_line | url_encode
  assign directions_url = 'https://www.google.com/maps/dir/?api=1&destination=' | append: destination
  assign phone_link = telephone.value | remove: ' ' | remove: '(' | remove: ')' | remove: '-'
-%}

<div data-section-id="{{ section.id }}" data-section-type="store-information-banner" class="store-information-banner">
    <div class="store-information-banner__info">
        {% if name != blank %}
            <h1 class="store-information-banner__title">{{ name.value | escape }}</h1>
        {% endif %}

        <div class="store-information-banner__columns">
            {% if address != blank %}
                <div class="store-information-banner__address">
                    <h2 class="store-information-banner__heading">{{ shop.name | escape }}</h2>
                    <address>{{ address_text | escape | newline_to_br }}</address>
                </div>
            {% endif %}

            {% if opening_times != blank %}
                <div class="store-information-banner__hours">
                    <h2 class="store-information-banner__heading">Opening hours</h2>
                    {%- comment -%} Stored as a table, so output as it is {%- endcomment -%}
                    {{ opening_times }}
                </div>
            {% endif %}
        </div>

        {% if store_details != blank %}
            <div class="store-information-banner__details">
                <h2 class="store-information-banner__heading">Store Details</h2>
                {% if store_details.type contains 'list.' %}
                    <ul class="store-information-banner__details-list">
                        {% for detail in store_details.value %}
                            {%- comment -%} Links the details that match a collection, e.g. "Carpets" -> /collections/carpets {%- endcomment -%}
                            {% comment %} {% assign detail_collection = collections[detail | handleize] %}
                            <li>
                                {% if detail_collection != blank and detail_collection.products_count > 0 %}
                                    <a href="{{ detail_collection.url }}">{{ detail | escape }}</a>
                                {% else %}
                                    {{ detail | escape }}
                                {% endif %}
                            </li> {% endcomment %}
                        {% endfor %}
                    </ul>
                {% else %}
                    <div class="store-information-banner__details-list">{{ store_details }}</div>
                {% endif %}
            </div>
        {% endif %}

        <div class="store-information-banner__buttons">
            {% if telephone != blank %}
                <a href="tel:{{ phone_link }}" class="store-information-banner__button">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" aria-hidden="true"><path d="M497.39 361.8l-112-48a24 24 0 0 0-28 6.9l-49.6 60.6A370.66 370.66 0 0 1 130.6 204.11l60.6-49.6a23.94 23.94 0 0 0 6.9-28l-48-112A24.16 24.16 0 0 0 122.6.61l-104 24A24 24 0 0 0 0 48c0 256.5 207.9 464 464 464a24 24 0 0 0 23.4-18.6l24-104a24.29 24.29 0 0 0-14.01-27.6z"/></svg>
                    {{ telephone.value | escape }}
                </a>
            {% endif %}
            {% if email != blank %}
                <a href="mailto:{{ email.value | escape }}" class="store-information-banner__button">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" aria-hidden="true"><path d="M502.3 190.8c3.9-3.1 9.7-.2 9.7 4.7V400c0 26.5-21.5 48-48 48H48c-26.5 0-48-21.5-48-48V195.6c0-5 5.7-7.8 9.7-4.7 22.4 17.4 52.1 39.5 154.1 113.6 21.1 15.4 56.7 47.8 92.2 47.6 35.7.3 72-32.8 92.3-47.6 102-74.1 131.6-96.3 154-113.7zM256 320c23.2.4 56.6-29.2 73.4-41.4 132.7-96.3 142.8-104.7 173.4-128.7 5.8-4.5 9.2-11.5 9.2-18.9v-19c0-26.5-21.5-48-48-48H48C21.5 64 0 85.5 0 112v19c0 7.4 3.4 14.3 9.2 18.9 30.6 23.9 40.7 32.4 173.4 128.7 16.8 12.2 50.2 41.8 73.4 41.4z"/></svg>
                    Email
                </a>
            {% endif %}
            {% if address != blank %}
                <a href="{{ directions_url | escape }}" class="store-information-banner__button" target="_blank" rel="noopener">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512" aria-hidden="true"><path d="M0 117.66v346.32c0 11.32 11.43 19.06 21.94 14.86L160 416V32L20.12 87.95A32.006 32.006 0 0 0 0 117.66zM192 416l192 64V96L192 32v384zM554.06 33.16L416 96v384l139.88-55.95A31.996 31.996 0 0 0 576 394.34V48.02c0-11.32-11.43-19.06-21.94-14.86z"/></svg>
                    Get Directions
                </a>
            {% endif %}
            {% if other_store != blank %}
                <a href="{{ other_store.system.url }}" class="store-information-banner__button store-information-banner__button--secondary">
                    View {{ other_store.name.value | escape }} Store
                </a>
            {% endif %}
        </div>
    </div>

    {% if image != blank %}
        <div class="store-information-banner__image">
            {{ image.value | image_url: width: 1600 | image_tag: loading: 'eager', sizes: '(min-width: 900px) 60vw, 100vw', widths: '600, 900, 1200, 1600', alt: name.value }}
        </div>
    {% endif %}
</div>

{% schema %}
  {
    "name": "Store Information Banner",
    "class": "index-section",
    "presets": [
      {
        "name": "Store Information Banner",
        "category": "Content"
      }
    ]
  }
{% endschema %}
