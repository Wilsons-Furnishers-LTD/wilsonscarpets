<div class="compare-modal-container">
    <div class="compare-modal">
        <div class="compare-modal__header">
            <div class="compare-modal__header--main-col">
                <div class="compare-modal__header--title">Compare Products</div>
                <div class="compare-modal__header--amount">Comparing <span id="compare-count"></span></div>
            </div>
            <div class="compare-modal__header--col">
                <button id="clear-product-ids">Clear all</button>
                <button id="close-compare-modal">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M6 6l12 12M18 6L6 18"/>
                    </svg>
                </button>
            </div>
        </div>
        <nav class="compare-modal__nav">

        </nav>
        <div class="compare-modal__grids"></div>
    </div>
    <div class="compare-modal-background"></div>
</div>
