    function swatchClick(value, variant_id, index){
        /* change image */
        const $productPhotoContainer = jQuery('.product-photo-container');
        const $mainImage = $productPhotoContainer.find('img');
        const $mainImageSource = $productPhotoContainer.find('source');
        const $photoThumbHolder = jQuery('.product-photo-thumbs-holder');


        if(
            $productPhotoContainer.data('photoui') &&
            ($productPhotoContainer.data('photoui') === 'true' || $productPhotoContainer.data('photoui') === true)
        ){
            //to catch undefined
            try{
                if(typeof variantsAndImages[variant_id] !== "undefined"){
                    const currentValue = jQuery('.swatch-colours .grid li.selected').data('value');


                    const thumbs = variantsAndImages[variant_id].thumbs;
                    const large = variantsAndImages[variant_id].large;


                    let photoThumbs = '';
                    let photoLarges = '';
                    let i = 0;
                    let load = jQuery('.swatch-colours').data('load'); //second click will be true;
                    let imageIndex = 0;

                    if(index === 0){
                        //first swatch, show the life style image
                        i = 0;
                    }else{
                        //not first swatch, start with index 1
                        i = 1;
                    }

                    for(i; i < thumbs.length; i++){
                        const largePhoto = thumbs[i];
                        var cssClass = '';

                        if(index === 0){
                            if(i === 0){
                                cssClass = 'active';
                            }
                        }else{
                            if(i === 1){
                                cssClass = 'active';
                            }
                        }

                        photoThumbs += '<li class="product-photo-thumb two-per-row"><a href="#" class="data '+cssClass+'"><img src="'+thumbs[i]+'" alt=""></a></li>';

                        photoLarges += '<div class="item" data-index="'+ i +'">'+
                            '<a class="featherlight-gallery" href="'+largePhoto.replace('_80x80_crop_center', '_1600x1600')+'">' +
                                '<picture class="product-photo-container__frame">'+
                                    '<source media="(min-width: 1024px)" srcset="'+ largePhoto.replace('_80x80_crop_center', '_600x600') +'">'+
                                    '<source srcset="'+ largePhoto.replace('_80x80_crop_center', '_860x860') +'">'+
                                    '<img class="product-photo-container__img" src="'+ largePhoto.replace('_80x80_crop_center', '_600x600') +'" alt="'+currentValue+'" />'+
                                '</picture>'+
                            '</a>'+
                            '<span class="zoom-mobile"><img src="'+ largePhoto.replace('_80x80_crop_center', '_860x860') +'" alt="" /></span>'+
                        '</div>';
                    }
                    photoThumbs = '<ul class="product-photo-thumbs">' + photoThumbs + '</ul>';
                    photoLarges = '<div class="owl-carousel">' + photoLarges + '</div>';


                    if( variantsAndImages[variant_id].thumbs.length > 1 ){
                        $photoThumbHolder.empty().append(photoThumbs);
                        $productPhotoContainer.empty().append(photoLarges);
                        carouselInit();
                    }else{
                        $photoThumbHolder.empty();
                        $productPhotoContainer.empty().append(photoLarges);
                        carouselInit(false);
                    }
                }
            }catch(err){
                console.log(err);
            }

        }

        jQuery('.option-size select option').attr('disabled','disabled');
        jQuery('#product-select').find('option').each(function(){
            var thisOption = jQuery(this).text().trim();
            if(thisOption.includes(value)){
                jQuery('.option-size select option').each(function(){
                    if(thisOption.includes($(this).val())) {
                        jQuery(this).removeAttr('disabled');
                    }
                });
            }
        });
        jQuery('.option-size select option').filter(":selected").each(function(){
            if (jQuery(this).attr('disabled')) {
                jQuery(this).parent().find('option').first().attr('selected','selected');
            }
        });
        
        colour_select(value);

        size_select();
        updatePrice();
        {% if product.type == 'Laminate' or product.type == 'LVT' %}
            updateLinworkAttribute();
        {% endif %}
        check_submit_button();

        jQuery('.js-product-photo-thumb').each(function () {
            if (jQuery(this).attr('data-value') == value) {
                jQuery(this).click();
            }
        });

