<div class="compare-modal-container">
    <div class="compare-modal compare-modal--aside-closed compare-modal--no-aside">
        <div class="compare-modal__header">
            <div class="compare-modal__header--main-col">
                <div class="compare-modal__header--title">Compare Products</div>
                <div class="compare-modal__header--amount">Comparing <span id="compare-count"></span></div>
            </div>
            <div class="compare-modal__more-products-wrapper">
                <button type="button" class="compare-modal__more-products" aria-controls="compare-add-product" aria-expanded="false" hidden>
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 5V19M5 12H19"
                                
                                stroke-width="2.5"
                                stroke-linecap="round"/>
                    </svg>
                    <span>Add products</span>
                </button>
            </div>
            <a href="#" class="comparison-page__share"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><!--!Font Awesome Free v5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path d="M352 320c-22.608 0-43.387 7.819-59.79 20.895l-102.486-64.054a96.551 96.551 0 0 0 0-41.683l102.486-64.054C308.613 184.181 329.392 192 352 192c53.019 0 96-42.981 96-96S405.019 0 352 0s-96 42.981-96 96c0 7.158.79 14.13 2.276 20.841L155.79 180.895C139.387 167.819 118.608 160 96 160c-53.019 0-96 42.981-96 96s42.981 96 96 96c22.608 0 43.387-7.819 59.79-20.895l102.486 64.054A96.301 96.301 0 0 0 256 416c0 53.019 42.981 96 96 96s96-42.981 96-96-42.981-96-96-96z"></path></svg><span>Share</span></a>
            <div class="compare-modal__header--col">
                
                <button id="clear-product-ids">Clear all <span class="compare-modal__total-count"></span></button>
                <button id="close-compare-modal">
                    
                </button>
            </div>
        </div>
        {%- comment -%} Below 769px compare.js moves "Add products" and "Share" here from the header {%- endcomment -%}
        <div class="compare-modal__actions"></div>
        <nav class="compare-modal__nav">

        </nav>
        <div class="compare-modal__grids"></div>
        <div class="compare-modal__add-product" id="compare-add-product" hidden>
            <div class="compare-modal__add-product--header">
                <div class="compare-modal__add-product--title">
                    Add product
                </div>
                <button type="button" class="compare-modal__add-product--close" aria-label="Close add product">
                    
                </button>
            </div>
            <div class="compare-modal__add-product--search">
                <input type="search" id="compare-add-product-search" placeholder="Search products" aria-label="Search products" autocomplete="off">
            </div>
        </div>
        <div class="compare-modal__add-product-backdrop"></div>
    </div>
    <div class="compare-modal-background"></div>
</div>

<button type="button" class="compare-open-button" hidden>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 8h16"/>
        <path d="m16 4 4 4-4 4"/>
        <path d="M20 16H4"/>
        <path d="m8 12-4 4 4 4"/>
    </svg>
    <span>Compare</span>
    <div class="compare-open-button__count--container"><span class="compare-open-button__count"></span></div>
</button>

{% render 'compare-share' %}