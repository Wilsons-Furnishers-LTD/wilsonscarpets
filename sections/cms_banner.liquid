<div data-section-id="{{ section.id }}" data-section-type="banner" class="banner-one">
    {% if section.settings.full_width == false %}
    <div class="wrapper">
    {% endif %}
    <div class="container {{ border_bottom }} {{ border_top }}">
        <div class="row">
                <div class="col-wide-12 {{ section.settings.text_color | escape }}">
                    {% if section.settings.image %}
                        {% if section.settings.link != blank %}
                        <a class="image" href="{{ section.settings.link_1 }}">
                        {% endif %}	
                            <picture>
                                <source media="(min-width: 1024px)" srcset="{{ section.settings.image | img_url: '1920x' }}">
                                <source media="(min-width: 768px)" srcset="{{ section.settings.image | img_url: '1024x680', crop: 'center' }}">
                                {% if section.settings.mobile_image != blank %}
                                    <source srcset="{{ section.settings.mobile_image | img_url: '1920x' }}">
                                {% else %}
                                    <source srcset="{{ section.settings.image | img_url: '640x600', crop: 'center' }}">    
                                {% endif %}
                                <img src="{{ section.settings.image | img_url: '1920x' }}" alt="" />
                            </picture>
                        {% if section.settings.link != blank %}
                            </a>
                        {% endif %}	
                    {% else %}
                    <span class="placeholder-background">
                        {% capture current %}{% cycle 1, 2 %}{% endcapture %}
                        {{ 'lifestyle-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                    </span>
                    {% endif %}
                    <div class="text-wrap {{ section.settings.button_position }} button_position {{ section.settings.vertical_align }} {{ section.settings.horizontal_align }}">
                        <div class="wrapper">
                            <div class="text-content">
                                {% unless section.settings.title == blank %}
                                {% if section.settings.is_title_h1 == 'is_title_h1_yes' %}
                                    <h1 class="title">
                                        {{ section.settings.title | escape }}
                                    </h1>
                                {% else %}
                                    <h2 class="title">
                                        {{ section.settings.title | escape }}
                                    </h2>
                                {% endif %}
                                {% endunless %}
                                {% unless section.settings.subheading == blank %}
                                <div class="subtitle">{{ section.settings.subheading }}</div>
                                {% endunless %}
                                <div class="buttons">
                                {% if section.settings.link_1 != blank %}
                                    <p><a class="button small {% if section.settings.text_color == 'text-light' %}button-white{% else %}button-black{% endif %}" href="{{ section.settings.link_1 }}">{{ section.settings.button_text_1 }}</a></p>
                                {% endif %}	
                                {% if section.settings.link_2 != blank %}
                                    <p><a class="button small {% if section.settings.text_color == 'text-light' %}button-white{% else %}button-black{% endif %}" href="{{ section.settings.link_2 }}">{{ section.settings.button_text_2 }}</a></p>
                                {% endif %}	
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
        </div>
    </div>
    {% if section.settings.full_width == false %}
    </div>
    {% endif %}
</div>


{% schema %}
    {
        "name": "Banner Grid - One",
        "settings": [
			 	{
                    "type": "image_picker",
                    "id": "image",
                    "label": "Image"
                },
                {
                    "type": "image_picker",
                    "id": "mobile_image",
                    "label": "Mobile Image"
                },
				{
                    "type": "checkbox",
                    "id": "full_width",
                    "label": "Full Width",
                    "default": true
                },
                {
                    "type": "url",
                    "id": "link",
                    "label": "Image Link"
                },
                {
                    "type": "select",
                    "id": "text_color",
                    "label": "Text color",
                    "options": [
                        { "value": "text-light", "label": "Light" },
                        { "value": "text-dark", "label": "Dark" }
                    ],
                    "default": "text-light"
                },
                {
                    "type": "text",
                    "id": "title",
                    "label": "Heading",
                    "default": "Image slide"
                },
				{
					"type": "select",
					"id": "is_title_h1",
					"label": "Wrap title in H1 tag?",
					"options": [
					{ "value": "is_title_h1_yes", "label": "Yes" },
					{ "value": "is_title_h1_no", "label": "No" }
					],
					"default": "is_title_h1_no"
				},
                {
                    "type": "textarea",
                    "id": "subheading",
                    "label": "Subheading",
                    "default": "Lorem ipsum dolor sit amet"
                },
				{
                    "type": "select",
                    "id": "vertical_align",
                    "label": "Vertical align",
                    "options": [
                        { "value": "top", "label": "Top" },
                        { "value": "middle", "label": "Middle" },
                        { "value": "bottom", "label": "Bottom" }
                    ],
                    "default": "middle"
                },
                {
                    "type": "select",
                    "id": "horizontal_align",
                    "label": "Horizontal align",
                    "options": [
                        { "value": "left", "label": "Left" },
                        { "value": "center", "label": "Center" },
                        { "value": "right", "label": "Right" }
                    ],
                    "default": "center"
                },
                {
                    "type": "url",
                    "id": "link_1",
                    "label": "Button Link 1"
                },
                {
                    "type": "text",
                    "id": "button_text_1",
                    "label": "Button Text 1",
                    "default": "Shop Now"
                },
                {
                    "type": "url",
                    "id": "link_2",
                    "label": "Button Link 2"
                },
                {
                    "type": "text",
                    "id": "button_text_2",
                    "label": "Button Text 2",
                    "default": "Shop Now"
                },
				{
                    "type": "select",
                    "id": "button_position",
                    "label": "Button Position",
                    "options": [
                        { "value": "button-top", "label": "Top" },
                        { "value": "button-below-content", "label": "Below Content" },
                        { "value": "button-bottom", "label": "Bottom" }
                    ],
                    "default": "button-below-content"
                },
				{
					"type": "select",
					"id": "add_border_top",
					"label": "Add border top?",
					"options": [
					{ "value": "add_border_top_yes", "label": "Yes" },
					{ "value": "add_border_top_no", "label": "No" }
					],
					"default": "add_border_top_no"
				},
				{
					"type": "select",
					"id": "add_border_bottom",
					"label": "Add border bottom?",
					"options": [
					{ "value": "add_border_bottom_yes", "label": "Yes" },
					{ "value": "add_border_bottom_no", "label": "No" }
					],
					"default": "add_border_bottom_no"
				}
			],
        "presets": [{
            "name": "Banner Grid - One",
            "category": "Image"
        }]
	}
{% endschema %}
